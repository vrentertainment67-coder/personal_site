<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Vic's Portfolio Desk</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif&display=swap" rel="stylesheet">
<style>
:root{--bg:#EEF1F4;--panel:#FFFFFF;--ink:#1B2433;--mute:#5E6878;--line:#D5DBE3;--gain:#1F7A5A;--loss:#B4423A;--mari:#E0A21B;--mari-soft:#F6E6BE;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141B26;--panel:#1C2533;--ink:#E7ECF2;--mute:#97A2B3;--line:#2E3A4C;--gain:#4CC495;--loss:#EE7B70;--mari:#F0B83A;--mari-soft:#3D3320}}
:root[data-theme="dark"]{--bg:#141B26;--panel:#1C2533;--ink:#E7ECF2;--mute:#97A2B3;--line:#2E3A4C;--gain:#4CC495;--loss:#EE7B70;--mari:#F0B83A;--mari-soft:#3D3320}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 "Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;font-variant-numeric:tabular-nums}
main{max-width:1080px;margin:0 auto;padding:28px 18px 60px}
.date{color:var(--mute);font-size:13px;margin:0 0 6px}
h1{font:400 clamp(30px,6vw,52px)/1.08 "Instrument Serif",Georgia,serif;margin:0 0 18px;max-width:22ch;letter-spacing:-.01em}
.banner{display:flex;gap:10px;align-items:flex-start;background:var(--mari-soft);border-left:3px solid var(--mari);border-radius:0 6px 6px 0;padding:11px 14px;margin:0 0 22px;font-size:13.5px;color:var(--ink)}
.banner b{font-weight:600}
.strip{display:flex;height:64px;border-radius:6px;overflow:hidden;background:var(--line)}
.strip div{height:100%;border-right:2px solid var(--bg);position:relative;min-width:2px;cursor:default}
.strip div:last-child{border-right:0}
.strip div.top{background:var(--mari)}
.strip div.rest{background:var(--mute);opacity:.35}
.strip div.rest:hover{opacity:.7}
.strip span{position:absolute;left:8px;bottom:6px;font-size:12px;font-weight:600;color:#1B2433;white-space:nowrap}
.strip span b{display:block;font-size:18px}
.legend{display:flex;justify-content:space-between;gap:12px;color:var(--mute);font-size:12px;margin-top:6px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden;margin:26px 0}
.stats>div{background:var(--panel);padding:14px 16px}
.stats small{color:var(--mute);display:block;font-size:13px}
.stats strong{font-size:22px;font-weight:600;display:block}
.stats em{color:var(--mute);font-size:12px;font-style:normal}
h2{font-size:19px;font-weight:600;margin:36px 0 12px}
.cols{display:grid;grid-template-columns:1.1fr .9fr;gap:24px}
@media(max-width:760px){.cols{grid-template-columns:1fr}}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:16px}
.sec{display:grid;grid-template-columns:132px 1fr 92px;align-items:center;gap:10px;font-size:14px;margin:7px 0}
.bar{height:10px;background:var(--line);border-radius:5px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--ink);border-radius:0 4px 4px 0}
.sec .pct{text-align:right;color:var(--mute);font-size:13px}
.flag{border-left:3px solid var(--mari);padding:4px 0 4px 12px;margin:0 0 15px}
.flag:last-child{margin-bottom:0}
.flag.loss{border-color:var(--loss)}
.flag p{margin:2px 0 0;color:var(--mute);font-size:14px}
.flag strong{font-weight:600}
.pending{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden}
.pending>div{background:var(--panel);padding:14px 16px}
.pending strong{display:block;font-weight:600;margin-bottom:3px}
.pending strong::before{content:"◌ ";color:var(--mari)}
.pending p{margin:0;color:var(--mute);font-size:13.5px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:14px 16px}
.card header{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:12px}
.card h3{margin:0;font-size:15px;font-weight:600}
.card .big{font-size:20px;font-weight:600}
.ruler{position:relative;height:8px;background:linear-gradient(90deg,var(--gain) 0%,var(--line) 45%,var(--line) 55%,var(--loss) 100%);opacity:.75;border-radius:4px;margin:22px 0 8px}
.ruler i{position:absolute;top:-6px;width:2px;height:20px;background:var(--ink);border-radius:1px}
.ruler i::after{content:attr(data-label);position:absolute;top:-17px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:600;white-space:nowrap;color:var(--ink)}
.ends{display:flex;justify-content:space-between;font-size:12.5px;color:var(--mute);gap:12px}
.ends b{display:block;color:var(--ink);font-weight:600}
.ends div:last-child{text-align:right}
.meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:11px;font-size:12px;color:var(--mute)}
.meta span{background:var(--bg);border-radius:4px;padding:2px 7px}
.watch{background:var(--panel);border:1px solid var(--line);border-radius:8px;overflow:hidden}
.watch>div{padding:13px 16px;border-bottom:1px solid var(--line)}
.watch>div:last-child{border-bottom:0}
.watch header{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.watch h3{margin:0;font-size:15px;font-weight:600}
.watch .sym{color:var(--mute);font-size:12.5px}
.watch .px{margin-left:auto;font-size:14px}
.watch ul{margin:7px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:3px}
.watch li{font-size:13.5px;color:var(--mute);padding-left:14px;position:relative}
.watch li::before{content:"";position:absolute;left:0;top:7px;width:6px;height:6px;border-radius:50%;background:var(--mute)}
.watch li.good::before{background:var(--gain)}
.watch li.bad::before{background:var(--loss)}
.watch li.warn::before{background:var(--mari)}
.brief{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px 20px}
.brief h3{margin:0 0 3px;font-size:14px;font-weight:600}
.brief p{margin:0 0 14px;font-size:14.5px;line-height:1.6}
.brief p:last-child{margin-bottom:0}
.brief .by{color:var(--mute);font-size:12px;margin-top:14px;border-top:1px solid var(--line);padding-top:10px}
.newslist{list-style:none;margin:0;padding:0;font-size:13.5px}
.newslist li{padding:7px 0;border-bottom:1px solid var(--line)}
.newslist li:last-child{border-bottom:0}
.newslist b{font-weight:600}
.newslist span{color:var(--mute)}
.tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px}
input,select{font:inherit;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:8px 10px}
input{flex:1;min-width:180px}
input:focus-visible,select:focus-visible,th:focus-visible{outline:2px solid var(--mari);outline-offset:1px}
.tablewrap{overflow-x:auto;background:var(--panel);border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%;min-width:820px;font-size:14px}
th,td{padding:9px 12px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{text-align:left}
tr:last-child td{border-bottom:0}
th{font-weight:600;color:var(--mute);cursor:pointer;user-select:none;position:sticky;top:0;background:var(--panel)}
th[aria-sort]::after{content:" ▾";color:var(--mari)}
th[aria-sort="ascending"]::after{content:" ▴"}
td small{display:block;color:var(--mute);font-size:12px}
.g{color:var(--gain)}.l{color:var(--loss)}.na{color:var(--mute)}
.tag{font-size:11px;background:var(--mari-soft);color:var(--ink);padding:1px 6px;border-radius:4px;margin-left:6px;white-space:nowrap}
.src{display:flex;flex-wrap:wrap;gap:8px;margin:0}
.src div{display:flex;align-items:center;gap:7px;background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-size:13px}
.src i{width:8px;height:8px;border-radius:50%;flex:none;background:var(--mute)}
.src .ok i{background:var(--gain)}.src .stale i{background:var(--mari)}.src .failed i{background:var(--loss)}
.src small{color:var(--mute)}
footer{color:var(--mute);font-size:13px;margin-top:30px;max-width:76ch}
footer p{margin:0 0 8px}
@media print{body{background:#fff}.tools{display:none}}
</style>
</head>
<body>
<main>
<p class="date">Built {{ generated_at }} · holdings as of {{ holdings_as_of }} ({{ holdings_source }})</p>
<h1>{{ headline }}</h1>

{% if not stale %}
<p class="date">{{ price_note }}</p>
{% endif %}
{% if stale %}
<p class="banner"><span aria-hidden="true">⚠</span><span><b>{% if price_tier == 'snapshot' %}Prices are not live.{% else %}No prices available.{% endif %}</b>
{{ price_note }} Every figure below that depends on a price is as of {{ price_as_of }}, not today.</span></p>
{% endif %}

<div class="strip" role="img" aria-label="Each holding sized by value: {% for s in strip %}{{ s.name }} {{ s.weight_txt }}{{ ", " if not loop.last }}{% endfor %}">
{% for s in strip %}
 <div class="{{ 'top' if s.top else 'rest' }}" style="flex:{{ '%.4f'|format(s.value) }}" title="{{ s.name }}: {{ s.weight_txt }} ({{ s.value_txt }})">
{% if s.top %}  <span><b>{{ s.weight_txt }}</b>{{ s.short }}</span>{% endif %}
 </div>
{% endfor %}
</div>
<div class="legend"><span>Each block is one holding, sized by value</span><span>{{ row_count }} holdings{% if attention.unlisted or strip|length < row_count %} · {{ row_count - strip|length }} without a price{% endif %}</span></div>

<div class="stats">
{% for t in tiles %}
 <div><small>{{ t.label }}</small><strong{% if t.tone %} class="{{ t.tone }}"{% endif %}>{{ t.value }}</strong><em>{{ t.note }}</em></div>
{% endfor %}
</div>

<div class="cols">
 <section>
  <h2>Where your money sits</h2>
  <div class="panel">
{% for s in sectors %}
   <div class="sec"><span>{{ s.name }}</span><div class="bar" title="{{ s.name }}: {{ s.weight_txt }} ({{ s.value_txt }}, {{ s.count }} holding{{ 's' if s.count != 1 }})"><i style="width:{{ '%.2f'|format(s.bar_pct) }}%"></i></div><span class="pct">{{ s.weight_txt }}</span></div>
{% endfor %}
  </div>
 </section>
 <section>
  <h2>Worth a look</h2>
  <div class="panel">
{% for n in portfolio_notes %}
   <div class="flag{{ ' loss' if n.tone == 'bad' }}"><strong>{{ n.headline }}</strong><p>{{ n.detail }}</p></div>
{% endfor %}
{% for f in flags %}
   <div class="flag{{ ' loss' if f.tone == 'loss' }}"><strong>{{ f.title }}</strong><p>{{ f.body }}</p></div>
{% endfor %}
  </div>
 </section>
</div>

{% if brief and brief.ok %}
<h2>This morning</h2>
<div class="brief">
{% for para in brief.paragraphs %}
{% if para.heading %}
 <h3>{{ para.heading }}</h3>
{% endif %}
 <p>{{ para.body }}</p>
{% endfor %}
 <p class="by">Written by {{ brief.model }} from the figures on this page. Every number in it was
 checked back against that data before publishing. Reference only, not investment advice.</p>
</div>
{% endif %}

{% if indices %}
<h2>Index levels</h2>
<div class="cards">
{% for ix in indices %}
 <div class="card">
  <header><h3>{{ ix.name }}</h3><span class="big">{{ ix.last }}</span>
   <span class="{{ ix.change_tone }}">{{ ix.change }}</span></header>
  <div class="ruler" role="img" aria-label="{{ ix.name }} at {{ ix.last }}, support {{ ix.support }}, resistance {{ ix.resistance }}">
   <i style="left:{{ '%.1f'|format(ix.marker_pct) }}%" data-label="{{ ix.last }}"></i>
  </div>
  <div class="ends">
   <div>support <b>{{ ix.support }}</b>{{ ix.support_dist }} · {{ ix.support_methods }}</div>
   <div>resistance <b>{{ ix.resistance }}</b>{{ ix.resistance_dist }} · {{ ix.resistance_methods }}</div>
  </div>
  <div class="meta">
{% if ix.cpr %}   <span>CPR {{ ix.cpr }} ({{ ix.cpr_width }})</span>{% endif %}
{% if ix.put_oi %}   <span>highest put OI {{ ix.put_oi }}</span>{% endif %}
{% if ix.call_oi %}   <span>highest call OI {{ ix.call_oi }}</span>{% endif %}
{% if ix.pcr %}   <span>PCR {{ ix.pcr }}</span>{% endif %}
{% if ix.max_pain %}   <span>max pain {{ ix.max_pain }}</span>{% endif %}
  </div>
 </div>
{% endfor %}
</div>
{% endif %}

{% if watchlist %}
<h2>Worth your attention today</h2>
<div class="watch">
{% for w in watchlist %}
 <div>
  <header><h3>{{ w.name }}</h3><span class="sym">{{ w.symbol }} · {{ w.weight }} of book</span>
   <span class="px">{{ w.last }} <span class="{{ w.change_tone }}">{{ w.change }}</span></span></header>
  <ul>
{% for r in w.reasons %}
   <li class="{{ r.tone }}">{{ r.text }}</li>
{% endfor %}
  </ul>
 </div>
{% endfor %}
</div>
<p class="legend"><span>Ranked by how many signals agree, weighted by position size. Descriptive only — no recommendations.</span></p>
{% endif %}

{% if news %}
<h2>News touching your holdings</h2>
<div class="panel"><ul class="newslist">
{% for n in news %}
 <li><b>{{ n.symbol }}</b> {{ n.title }} <span>({{ n.source }})</span></li>
{% endfor %}
</ul></div>
{% endif %}

<h2>All holdings</h2>
<div class="tools">
 <input id="q" type="search" placeholder="Search by name or symbol" aria-label="Search holdings">
 <select id="sf" aria-label="Filter by sector"><option value="">All sectors</option>
{% for s in sector_names %}
  <option value="{{ s }}">{{ s }}</option>
{% endfor %}
 </select>
</div>
<div class="tablewrap"><table>
<thead><tr>
<th data-k="name" tabindex="0">Holding</th>
<th data-k="qty" tabindex="0">Qty</th>
<th data-k="avg" tabindex="0">Avg cost</th>
<th data-k="price" tabindex="0">Price</th>
<th data-k="value" tabindex="0" aria-sort="descending">Value</th>
<th data-k="weight" tabindex="0">Weight</th>
<th data-k="unreal" tabindex="0">Unrealised P/L</th>
<th data-k="ret" tabindex="0">Return</th>
</tr></thead>
<tbody id="tb"></tbody>
</table></div>

{% if pending %}
<h2>Not available this run</h2>
<div class="pending">
{% for p in pending %}
 <div><strong>{{ p.title }}</strong><p>{{ p.body }}</p></div>
{% endfor %}
</div>
{% endif %}

<h2>Where the numbers came from</h2>
<div class="src">
{% for s in statuses %}
 <div class="{{ s.health }}"><i aria-hidden="true"></i><span>{{ s.name }}</span><small>{{ s.label }}{% if s.detail %} — {{ s.detail }}{% endif %}</small></div>
{% endfor %}
</div>

<footer>
<p>Read from broker-app screenshots, so double-check anything that looks off.
{% if attention.incomplete %}{{ attention.incomplete|join(', ') }} {{ 'was' if attention.incomplete|length == 1 else 'were' }} cut off in the screenshots and {{ 'is' if attention.incomplete|length == 1 else 'are' }} still unconfirmed. {% endif %}Holdings with no average cost show value and weight but no return, because a missing cost basis is not the same as a zero one.</p>
<p>Reference only, not investment advice.</p>
</footer>
</main>

<script type="application/json" id="rows">{{ rows_json|safe }}</script>
<script>
const D = JSON.parse(document.getElementById("rows").textContent);
const cls = n => n == null ? "na" : n >= 0 ? "g" : "l";
const tierTag = { snapshot: "last close", none: "no price" };
let key = "value", asc = false;

function cell(d) {
  const tags = [];
  if (d.no_cost) tags.push("no cost");
  if (d.unlisted) tags.push("unlisted");
  else if (d.unpriced) tags.push("no price");
  if (d.guessed) tags.push("ticker?");
  return `<tr>
    <td>${d.name}${tags.map(t => `<span class="tag">${t}</span>`).join("")}<small>${d.sym} · ${d.sector}</small></td>
    <td>${d.qty_txt}</td><td>${d.avg_txt}</td><td>${d.price_txt}</td>
    <td>${d.value_txt}</td><td>${d.weight_txt}</td>
    <td class="${cls(d.unreal)}">${d.unreal_txt}</td>
    <td class="${cls(d.ret)}">${d.ret_txt}</td></tr>`;
}

function render() {
  const q = document.getElementById("q").value.toLowerCase();
  const s = document.getElementById("sf").value;
  const rows = D
    .filter(d => (!s || d.sector === s) && (d.name.toLowerCase().includes(q) || d.sym.toLowerCase().includes(q)))
    .sort((a, b) => {
      let x = a[key], y = b[key];
      if (key === "name") return asc ? a.name.localeCompare(b.name) : b.name.localeCompare(a.name);
      // Missing figures sink to the bottom whichever way the column is sorted.
      if (x == null || y == null) return x == null ? (y == null ? 0 : 1) : -1;
      return asc ? x - y : y - x;
    });
  document.getElementById("tb").innerHTML = rows.map(cell).join("")
    || `<tr><td colspan="8" class="na">No holding matches that.</td></tr>`;
}

document.querySelectorAll("th").forEach(th => {
  const go = () => {
    const k = th.dataset.k;
    asc = key === k ? !asc : k === "name";
    key = k;
    document.querySelectorAll("th").forEach(t => t.removeAttribute("aria-sort"));
    th.setAttribute("aria-sort", asc ? "ascending" : "descending");
    render();
  };
  th.onclick = go;
  th.onkeydown = e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); go(); } };
});
document.getElementById("q").oninput = render;
document.getElementById("sf").onchange = render;
render();
</script>
</body>
</html>
