---
// Homepage "Pick your night" popup — shows the upcoming nights (both, when
// there are two) as a dismissible modal that links each to its series-page
// RSVP. Replaces the old single-event EventPopup. Dates come from the page as
// `events`; renders nothing when there's nothing upcoming.
//
// Visibility is a pure class toggle (.open → display:flex + keyframe fade), so
// it can't get stuck the way an [hidden]-attribute + opacity-transition can.
const { events = [] } = Astro.props;
// Key by the actual dates so a NEW weekend re-shows even if a past one was dismissed.
const key = events.length ? 'vic_weekend_' + events.map((e) => e.date).join('_') : '';
---
{events.length > 0 && (
  <div class="wp-overlay" id="wp-overlay" role="dialog" aria-modal="true" aria-labelledby="wp-title">
    <div class="wp-card">
      <button class="wp-close" id="wp-close" type="button" aria-label="Close">&times;</button>
      <span class="wp-eyebrow">{events.length > 1 ? 'This weekend · Two nights' : 'Next up'}</span>
      <h2 class="wp-title" id="wp-title">{events.length > 1 ? 'Pick your night' : 'Catch VIC live'}</h2>
      <p class="wp-sub">{events.length > 1 ? 'Two rooms, two vibes — come to one, or make a weekend of it.' : 'Get on the guest list.'}</p>
      <div class="wp-grid">
        {events.map((e) => (
          <a href={e.href} class={`wp-ev wp-ev--${e.theme}`}>
            <span class="wp-day">{e.day} · {e.dateLabel}</span>
            <span class="wp-name">{e.name}</span>
            <span class="wp-venue">📍 {e.venue}</span>
            <span class="wp-tag">{e.tag}</span>
            <span class="wp-rsvp">RSVP · Guest list &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </div>
)}

<script is:inline define:vars={{ key }}>
  function initWeekendPopup() {
    if (!key) return;
    var ov = document.getElementById('wp-overlay');
    if (!ov || ov.dataset.wpBound === '1') return;
    ov.dataset.wpBound = '1';
    var seen = false;
    try { seen = localStorage.getItem(key) === '1'; } catch (e) {}
    if (seen) return;
    function done() { try { localStorage.setItem(key, '1'); } catch (e) {} }
    function open() { ov.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function close() { ov.classList.remove('open'); document.body.style.overflow = ''; done(); }
    setTimeout(open, 1200);
    var c = document.getElementById('wp-close'); if (c) c.addEventListener('click', close);
    ov.addEventListener('click', function (e) { if (e.target === ov) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && ov.classList.contains('open')) close(); });
    [].forEach.call(ov.querySelectorAll('.wp-ev'), function (a) { a.addEventListener('click', done); });
  }
  document.addEventListener('astro:page-load', initWeekendPopup);
</script>

<style>
  .wp-overlay {
    display: none; position: fixed; inset: 0; z-index: 1200;
    background: rgba(0,0,0,0.82); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
    align-items: center; justify-content: center; padding: 1.5rem;
  }
  .wp-overlay.open { display: flex; opacity: 1; }

  .wp-card {
    position: relative; width: 100%; max-width: 560px;
    background: #111; border: 1px solid #1e1e1e; border-top: 3px solid #c9a84c;
    border-radius: 12px; padding: 2rem 1.8rem 1.8rem; text-align: center;
    box-shadow: 0 32px 100px rgba(0,0,0,0.9);
  }

  .wp-close {
    position: absolute; top: 12px; right: 14px; background: transparent; border: none;
    color: #888880; font-size: 22px; line-height: 1; cursor: pointer; padding: 4px 8px; transition: color 0.15s;
  }
  .wp-close:hover { color: #e0dccf; }
  .wp-eyebrow { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: #c9a84c; margin-bottom: 0.4rem; }
  .wp-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 7vw, 2.8rem); letter-spacing: 0.03em; text-transform: uppercase; color: #fff; margin: 0 0 0.35rem; line-height: 1; }
  .wp-sub { color: rgba(255,255,255,0.55); font-size: 0.9rem; margin: 0 0 1.3rem; }
  .wp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .wp-ev {
    display: flex; flex-direction: column; gap: 0.3rem; text-align: left;
    padding: 1.2rem 1.2rem 1.1rem 1.35rem; border-radius: 10px; text-decoration: none;
    background: #0d0d0d; border: 1px solid #1e1e1e; position: relative; overflow: hidden;
    transition: transform 0.15s, border-color 0.15s;
  }
  .wp-ev:hover { transform: translateY(-3px); }
  .wp-ev::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 3px; }
  .wp-ev--ff::before { background: linear-gradient(180deg, #e0402a, #f5872a); }
  .wp-ev--ff:hover { border-color: #5a2a1e; }
  .wp-ev--ck::before { background: linear-gradient(180deg, #c9a84c, #8a7433); }
  .wp-ev--ck:hover { border-color: #3a2e00; }
  .wp-day { font-family: 'Space Grotesk', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #c9a84c; }
  .wp-ev--ff .wp-day { color: #f5872a; }
  .wp-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 0.03em; text-transform: uppercase; color: #fff; line-height: 1; }
  .wp-venue { font-size: 0.8rem; color: rgba(255,255,255,0.55); }
  .wp-tag { font-size: 0.74rem; color: rgba(255,255,255,0.4); }
  .wp-rsvp { margin-top: 0.5rem; font-family: 'Space Grotesk', sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; }
  @media (max-width: 480px) {
    .wp-grid { grid-template-columns: 1fr; }
    .wp-card { padding: 1.8rem 1.3rem 1.4rem; }
  }
</style>
