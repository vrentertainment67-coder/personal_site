---
// /chamatkar/feedback — post-event feedback. Sent to guests ~3 hours after they
// check in (the send is manual for now; WhatsApp automation comes later). Three
// smileys + an optional comment, nothing else. Posts to the shared, already-
// deployed `submit-feedback` edge function (rate-limiting + abuse filter built
// in), landing in the DJ VIC feedback admin under this event's slug.
//
// event_feedback.category is locked to 4 values, so the smiley rating rides in
// the message as a clear prefix (e.g. "❤️ Loved it — great crowd"). Structured
// rating stats would need a small dedicated table later.
//
// Standalone kiosk page, noindex. ---- SET PER EDITION: EVENT_SLUG ----
const EVENT_SLUG    = "chamatkar-vol5";
const EVENT_TITLE   = "Chamatkar";
const EVENT_EDITION = "Vol. 5";

const SUPABASE_URL = "https://jftnhuutttmccmqnnybf.supabase.co";
const FEEDBACK_ENDPOINT = SUPABASE_URL + "/functions/v1/submit-feedback";

const RATINGS = [
  { key: "loved",  emoji: "❤️", label: "Loved it" },
  { key: "good",   emoji: "😊", label: "Good night" },
  { key: "meh",    emoji: "😐", label: "Could be better" },
];

// Shown only when "Could be better" is picked — lets a guest point at what.
const NIGGLES = ["Service", "Valet", "Drinks", "Music", "Sound", "Crowd", "Wait time"];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Your feedback — {EVENT_TITLE} {EVENT_EDITION}</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root{ --gold:#c9a84c; --gold2:#e2c475; --gold-dim:#8a7433; --bg:#0a0908; --card:#151311;
      --line:#2a261f; --off:#efe9dd; --mut:#a09884; }
    *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
    html,body{ margin:0; background:var(--bg); color:var(--off);
      font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; min-height:100dvh; }
    body{ background-image: radial-gradient(ellipse 90% 50% at 50% -8%, rgba(201,168,76,.12), transparent 68%);
      padding:max(22px,env(safe-area-inset-top)) 20px calc(28px + env(safe-area-inset-bottom));
      display:flex; align-items:center; justify-content:center; }
    .wrap{ width:100%; max-width:440px; margin:0 auto; }
    header{ text-align:center; padding:6px 0 18px; }
    .k{ font-size:11px; letter-spacing:.3em; text-transform:uppercase; color:var(--gold); font-weight:600; }
    .title{ font-family:'Cormorant Garamond',serif; font-weight:700; font-size:clamp(2rem,9vw,2.7rem);
      line-height:1.02; margin:.4rem 0 .1rem; color:#fff; }
    .sub{ color:var(--mut); font-size:.98rem; line-height:1.55; margin:.5rem auto 0; max-width:20rem; }
    .q{ text-align:center; font-family:'Cormorant Garamond',serif; font-style:italic; font-size:1.5rem;
      color:var(--gold2); margin:1.6rem 0 1rem; }
    .rates{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:0 0 1.4rem; }
    .rate{ background:#100e0c; border:1.5px solid var(--line); border-radius:16px; padding:1.1rem .4rem;
      cursor:pointer; text-align:center; transition:.14s; color:var(--mut); }
    .rate .emo{ font-size:2.1rem; line-height:1; display:block; filter:grayscale(.35); transition:.14s; }
    .rate .lab{ display:block; font-size:.74rem; margin-top:.5rem; font-weight:600; letter-spacing:.01em; }
    .rate[aria-pressed=true]{ border-color:var(--gold); background:rgba(201,168,76,.1); color:#fff; transform:translateY(-2px); }
    .rate[aria-pressed=true] .emo{ filter:none; }
    label.fld > span{ display:block; font-size:12px; color:var(--mut); margin:0 0 7px; letter-spacing:.03em; }
    textarea{ width:100%; min-height:110px; resize:vertical; background:#100e0c; border:1.5px solid var(--line);
      border-radius:13px; color:var(--off); font-family:'Cormorant Garamond',serif; font-size:1.15rem;
      line-height:1.55; padding:14px; outline:none; }
    textarea::placeholder{ color:#5c554a; font-style:italic; }
    textarea:focus{ border-color:var(--gold); }
    .niggles{ margin:-.2rem 0 .3rem; }
    .niggles-lab{ display:block; font-size:12px; color:var(--mut); margin:0 0 9px; letter-spacing:.03em; }
    .nchips{ display:flex; flex-wrap:wrap; gap:8px; }
    .nchip{ appearance:none; background:#100e0c; border:1.5px solid var(--line); color:var(--mut);
      font-family:inherit; font-size:.88rem; font-weight:600; padding:10px 16px; border-radius:100px; cursor:pointer; transition:.14s; }
    .nchip[aria-pressed=true]{ border-color:var(--gold); background:rgba(201,168,76,.14); color:#fff; }
    .go{ width:100%; padding:17px; border:none; border-radius:14px; font-size:17px; font-weight:700;
      color:#1a1407; background:linear-gradient(90deg,var(--gold-dim),var(--gold)); cursor:pointer;
      letter-spacing:.02em; margin-top:16px; }
    .go:disabled{ opacity:.5; cursor:default; }
    .foot{ text-align:center; color:#5c554a; font-size:11px; margin-top:22px; letter-spacing:.04em; }
    .hidden{ display:none !important; }
    .spin{ display:inline-block; width:15px; height:15px; border:2px solid rgba(0,0,0,.3);
      border-top-color:#1a1407; border-radius:50%; animation:sp .7s linear infinite; vertical-align:-2px; }
    @keyframes sp{ to{ transform:rotate(360deg); } }
    /* thank you */
    .done{ text-align:center; padding:2rem 0; }
    .done .burst{ font-size:2.6rem; }
    .done .big{ font-family:'Cormorant Garamond',serif; font-weight:700; font-size:clamp(2rem,10vw,2.8rem);
      color:#fff; margin:.5rem 0 .3rem; }
    .done p{ color:var(--mut); line-height:1.65; max-width:20rem; margin:0 auto; }
    .done .rule{ width:44px; height:2px; background:var(--gold); margin:1.3rem auto; }
  </style>
</head>
<body>
  <main class="wrap">
    <div id="app">
      <header>
        <div class="k">Thanks for coming</div>
        <div class="title">{EVENT_TITLE} {EVENT_EDITION}</div>
        <p class="sub">You made the room. One quick thing before you go —</p>
      </header>

      <div class="q">How was your night?</div>

      <div class="rates" id="rates" role="group" aria-label="How was your night?">
        {RATINGS.map((r) => (
          <button type="button" class="rate" data-key={r.key} data-emoji={r.emoji} data-label={r.label} aria-pressed="false">
            <span class="emo">{r.emoji}</span>
            <span class="lab">{r.label}</span>
          </button>
        ))}
      </div>

      <div class="niggles hidden" id="niggles">
        <span class="niggles-lab">What could be better? (tap any)</span>
        <div class="nchips" id="nchips">
          {NIGGLES.map((n) => (
            <button type="button" class="nchip" data-n={n} aria-pressed="false">{n}</button>
          ))}
        </div>
      </div>

      <label class="fld"><span>Anything else? (optional)</span>
        <textarea id="comment" maxlength="1200" placeholder="What made it — or what we could do better…"></textarea>
      </label>

      <button type="button" id="go" class="go" disabled>Send it</button>
      <div class="foot">{EVENT_TITLE} {EVENT_EDITION} · DJ VIC</div>
    </div>

    <div id="done" class="done hidden">
      <div class="burst">🙏</div>
      <div class="big">Thank you</div>
      <p>We read every word — it shapes the next Chamatkar. See you on the floor.</p>
      <div class="rule"></div>
    </div>
  </main>

  <script is:inline define:vars={{ EVENT_SLUG, FEEDBACK_ENDPOINT }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var chosen = null;
      var niggles = {};   // selected "could be better" categories

      var rates = $("rates");
      var nWrap = $("niggles");
      var nChips = $("nchips");

      rates.addEventListener("click", function (e) {
        var b = e.target.closest(".rate"); if (!b) return;
        chosen = { key: b.dataset.key, emoji: b.dataset.emoji, label: b.dataset.label };
        var all = rates.querySelectorAll(".rate");
        for (var i = 0; i < all.length; i++) all[i].setAttribute("aria-pressed", String(all[i] === b));
        // Category chips only make sense under "Could be better".
        var showN = chosen.key === "meh";
        nWrap.classList.toggle("hidden", !showN);
        if (!showN) {
          niggles = {};
          var cs = nChips.querySelectorAll(".nchip");
          for (var k = 0; k < cs.length; k++) cs[k].setAttribute("aria-pressed", "false");
        }
        $("go").disabled = false;
      });

      nChips.addEventListener("click", function (e) {
        var c = e.target.closest(".nchip"); if (!c) return;
        var n = c.dataset.n;
        if (niggles[n]) { delete niggles[n]; c.setAttribute("aria-pressed", "false"); }
        else { niggles[n] = true; c.setAttribute("aria-pressed", "true"); }
      });

      $("go").addEventListener("click", function () {
        if (!chosen) return;
        var comment = $("comment").value.trim();
        var cats = Object.keys(niggles);
        // The smiley rides in the message as a prefix (category is locked to 4
        // values server-side); tapped categories + comment are appended.
        var message = chosen.emoji + " " + chosen.label
          + (cats.length ? " [" + cats.join(", ") + "]" : "")
          + (comment ? " — " + comment : "");

        var go = $("go"); go.disabled = true; go.innerHTML = '<span class="spin"></span> Sending…';
        fetch(FEEDBACK_ENDPOINT, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ message: message, category: "feedback", event_slug: EVENT_SLUG, fingerprint: null })
        }).catch(function () {}).then(function () {
          // The server always returns success; show the thank-you either way.
          $("app").classList.add("hidden");
          $("done").classList.remove("hidden");
        });
      });
    })();
  </script>
</body>
</html>
