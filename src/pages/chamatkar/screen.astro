---
// Chamatkar — the venue TV. Full-screen: /chamatkar/screen?k=TOKEN
// Shows the big QR (→ /chamatkar/checkin) + live entry count. When a winner is
// drawn (host GO, or the fail-safe GO on this screen) it takes over and reveals
// the name in the operator-selected style — a spinning wheel of names, or a
// name reel — then returns to the QR. Winners arrive over Realtime; the pool is
// the live check-in list. ?demo=N fills a synthetic pool for rehearsal.
import Layout from '../../layouts/Layout.astro';
---
<Layout bare noindex title="Chamatkar — Screen" description="Chamatkar draw screen.">
  <main id="main-content" class="cs">

    <!-- QR / holding state -->
    <div class="cs-qr" id="cs-qr">
      <div class="cs-left">
        <span class="cs-eyebrow">DJ VIC · Live</span>
        <h1 class="cs-title">Chamatkar</h1>
        <p class="cs-tag">Scan to enter the draw.</p>
        <p class="cs-sub">Winners <b>called out live</b> through the night. One entry per person.</p>
        <div class="cs-count"><b id="cs-pool">0</b><span>in the draw</span></div>
      </div>
      <div class="cs-right">
        <div class="cs-qrpanel"><canvas id="cs-qrc" width="560" height="560" aria-label="Scan to enter"></canvas></div>
        <div class="cs-scan">Point your camera here</div>
      </div>
    </div>

    <!-- Draw takeover: two reveal styles (wheel / name reel), whichever the
         operator has selected. The winner arrives over Realtime; the animation
         is choreographed to land on that name. -->
    <div class="cs-draw" id="cs-draw" hidden>
      <span class="cs-draw-k" id="cs-draw-k">Drawing a winner…</span>

      <!-- STYLE: spinning wheel, names set radially -->
      <div class="cs-wheel-wrap" id="cs-wheel-wrap" hidden>
        <svg class="cs-wheel" id="cs-wheel-svg" viewBox="0 0 400 400" aria-hidden="true">
          <g id="cs-wheel"></g>
          <circle cx="200" cy="200" r="196" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="2"/>
          <circle cx="200" cy="200" r="24" fill="#0a0a0c" stroke="var(--gold)" stroke-width="3"/>
        </svg>
        <div class="cs-pointer" aria-hidden="true"></div>
        <!-- big names-only reveal, centred on the wheel once it lands -->
        <div class="cs-reveal" id="cs-reveal" hidden>
          <div class="cs-name-fit"><div class="cs-name" id="cs-name">—</div></div>
        </div>
      </div>

      <!-- STYLE: name reel — every name streams past, slows onto the winner -->
      <div class="cs-reel" id="cs-reel" hidden>
        <div class="cs-reelview"><div class="cs-track" id="cs-track"></div><div class="cs-reelmark" aria-hidden="true"><i></i></div></div>
      </div>
    </div>

    <!-- Fail-safe operator control: sits below the QR fold. The operator picks
         the reveal style here (used for host draws too), and can run the draw
         from the screen itself if the host phone can't. -->
    <section class="cs-ops" id="cs-ops">
      <span class="cs-ops-k">Screen control</span>
      <div class="cs-ops-style">
        <span class="cs-ops-lbl">Reveal style</span>
        <div class="cs-seg" id="cs-style">
          <button data-s="wheel" type="button" aria-pressed="true">Wheel</button>
          <button data-s="reel" type="button" aria-pressed="false">Name reel</button>
        </div>
      </div>
      <p class="cs-ops-note">This style is used for every draw — including the host's GO. The GO below is a fail-safe: use it only if the host phone can't run the draw.</p>
      <div class="cs-ops-count"><b id="cs-ops-pool">0</b> in the draw · <span id="cs-ops-won">0</span> won</div>
      <button id="cs-ops-go" class="cs-ops-go" type="button">GO</button>
      <button id="cs-ops-reset" class="cs-ops-reset" type="button">↺ Put everyone back</button>
    </section>

    <span class="cs-sync" id="cs-sync">○</span>
  </main>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import QRCode from 'qrcode';
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'https://jftnhuutttmccmqnnybf.supabase.co';
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'sb_publishable_ysWygc3QGKbfsUd0f7Evzw__98TEoo9';
  const ENTER_URL = 'https://djvicofficial.com/chamatkar/checkin';
  const $ = (id) => document.getElementById(id);
  const token = new URLSearchParams(location.search).get('k') || '';
  const H = { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}`, 'Content-Type': 'application/json' };
  const rpc = (fn, body) => fetch(`${SUPABASE_URL}/rest/v1/rpc/${fn}`, { method: 'POST', headers: H, body: JSON.stringify(body) });

  QRCode.toCanvas($('cs-qrc'), ENTER_URL, { width: 560, margin: 2, color: { dark: '#0a0a0c', light: '#ffffff' } }, () => {});

  // Winners tracked on the device (mirror of the host), so already-won names
  // leave the flash pool and the count. Broadcast keeps it in sync.
  const WON_KEY = 'chamatkar_won_' + token.slice(0, 10);
  const loadWon = () => { try { return new Set(JSON.parse(localStorage.getItem(WON_KEY) || '[]')); } catch { return new Set(); } };
  const saveWon = () => { try { localStorage.setItem(WON_KEY, JSON.stringify([...won])); } catch {} };
  let won = loadWon();
  let entries = [];
  let spinning = false;
  const pool = () => entries.filter((e) => !won.has(e.id));

  // Rehearsal / stress-test mode: open the screen with ?demo=150 to fill the
  // pool with N synthetic names entirely in the browser. Nothing is written to
  // the database, no token is needed, and a real check-in never sees it.
  const demoN = parseInt(new URLSearchParams(location.search).get('demo') || '', 10);
  const isDemo = Number.isFinite(demoN) && demoN > 0;
  const DEMO_FIRST = ['Aarav','Priya','Rohan','Ananya','Vikram','Sneha','Karan','Divya','Arjun','Meera','Rahul','Isha','Nikhil','Pooja','Sanjay','Neha','Aditya','Kavya','Varun','Tara','Dev','Riya','Manish','Sana','Yash','Anjali','Kabir','Nisha','Sameer','Diya','Rishi','Gauri','Aman','Lakshmi','Vivek','Simran','Harsh','Zoya','Naveen','Preeti'];
  const DEMO_LAST = ['Sharma','Rao','Nair','Iyer','Reddy','Menon','Gupta','Kapoor','Shetty','Bose','Das','Khan','Pillai','Mehta','Verma'];
  const demoEntries = () => Array.from({ length: Math.min(demoN, 500) }, (_, i) => ({
    id: 'demo' + i,
    name: DEMO_FIRST[i % DEMO_FIRST.length] + ' ' + DEMO_LAST[(i * 7) % DEMO_LAST.length],
    instagram: null,
  }));
  const refreshCount = () => {
    $('cs-pool').textContent = pool().length;
    $('cs-ops-pool').textContent = pool().length;
    $('cs-ops-won').textContent = won.size;
  };

  async function load() {
    if (isDemo) { entries = demoEntries(); refreshCount(); return; }
    if (!token) return;
    try { const res = await rpc('chamatkar_draw_list', { p_token: token }); if (res.ok) { entries = (await res.json()) || []; refreshCount(); } } catch {}
  }
  const showQR = () => { $('cs-draw').hidden = true; $('cs-reveal').hidden = true; $('cs-wheel-wrap').hidden = true; $('cs-reel').hidden = true; $('cs-qr').hidden = false; };
  const showDraw = () => { $('cs-qr').hidden = true; $('cs-draw').hidden = false; };

  // Reveal style — chosen by the operator on the screen, applied to every draw
  // (host GO included) and remembered on this device.
  const STYLE_KEY = 'chamatkar_style_' + token.slice(0, 10);
  let style = 'wheel';
  try { const s = localStorage.getItem(STYLE_KEY); if (s === 'reel' || s === 'wheel') style = s; } catch {}
  function setStyle(s) {
    if (spinning) return;
    style = s; try { localStorage.setItem(STYLE_KEY, s); } catch {}
    document.querySelectorAll('#cs-style button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.s === s)));
  }

  // Size the winner name to sit inside the wheel; wrap only as a last resort.
  function fitName(el, name) {
    el.textContent = name;
    const box = $('cs-wheel-wrap').getBoundingClientRect();
    const maxW = box.width * 0.80, maxH = box.height * 0.6;
    el.style.whiteSpace = 'nowrap';
    let size = Math.min(box.height * 0.26, 170);
    el.style.fontSize = size + 'px';
    while (el.scrollWidth > maxW && size > 30) { size -= 4; el.style.fontSize = size + 'px'; }
    if (el.scrollWidth > maxW) {            // long name — let it wrap
      el.style.whiteSpace = 'normal';
      while ((el.scrollWidth > maxW || el.scrollHeight > maxH) && size > 22) { size -= 3; el.style.fontSize = size + 'px'; }
    }
  }

  // ── Roulette wheel ─────────────────────────────────────────────────────────
  // The winner is already decided on the host phone and arrives over Realtime;
  // the wheel is choreographed to land its pointer on that winner's slice.
  const WHEEL_MAX = 24;                 // radial names let more slices stay legible
  const CX = 200, CY = 200, R = 192;
  let rot = 0;                          // accumulated wheel rotation (deg), never reset
  const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
  const shuffle = (a) => { for (let i = a.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [a[i], a[j]] = [a[j], a[i]]; } return a; };
  const firstName = (n) => { const f = String(n || '').trim().split(/\s+/)[0] || ''; return f.length > 12 ? f.slice(0, 11) + '…' : f; };
  const polar = (r, deg) => { const a = deg * Math.PI / 180; return [CX + r * Math.sin(a), CY - r * Math.cos(a)]; };
  function slicePath(a0, a1) {
    const [x0, y0] = polar(R, a0), [x1, y1] = polar(R, a1);
    const large = (a1 - a0) > 180 ? 1 : 0;
    return `M${CX} ${CY} L${x0.toFixed(2)} ${y0.toFixed(2)} A${R} ${R} 0 ${large} 1 ${x1.toFixed(2)} ${y1.toFixed(2)} Z`;
  }
  // Build the display set: always contains the winner; sampled down if the pool
  // is bigger than the wheel can show legibly.
  function displayList(winner) {
    let list = pool().slice();
    if (!list.some((e) => e.id === winner.id)) list.unshift(winner);
    if (list.length > WHEEL_MAX) {
      const others = shuffle(list.filter((e) => e.id !== winner.id)).slice(0, WHEEL_MAX - 1);
      list = shuffle([winner, ...others]);
    }
    return list;
  }
  function buildWheel(list) {
    const n = list.length, seg = 360 / n;
    const fs = Math.max(6, Math.min(19, 300 / n));
    const trim = n > 20 ? 10 : 14;
    let svg = '';
    for (let i = 0; i < n; i++) {
      const a0 = i * seg, a1 = (i + 1) * seg, mid = a0 + seg / 2, gold = i % 2 === 0;
      svg += `<path d="${slicePath(a0, a1)}" fill="${gold ? '#efc250' : '#2b2350'}" stroke="#0a0a0c" stroke-width="${n > 40 ? .5 : 1.2}" data-i="${i}"/>`;
      // Names set radially (reading out from the hub); flipped on the left half.
      const left = mid > 180, rot = left ? mid + 90 : mid - 90;
      const [tx, ty] = polar(R * (left ? 0.52 : 0.54), mid);
      let nm = firstName(list[i].name); if (nm.length > trim) nm = nm.slice(0, trim - 1) + '…';
      svg += `<text x="${tx.toFixed(1)}" y="${ty.toFixed(1)}" transform="rotate(${rot.toFixed(1)} ${tx.toFixed(1)} ${ty.toFixed(1)})" text-anchor="middle" dominant-baseline="middle" fill="${gold ? '#1a1206' : '#efe6ff'}" font-size="${fs.toFixed(1)}" font-weight="700" style="font-family:var(--font-body,system-ui,sans-serif)">${esc(nm)}</text>`;
    }
    $('cs-wheel').innerHTML = svg;
  }
  // Common close-out: record the winner, hold on the reveal, back to the QR.
  function finishReveal(winner) {
    spinning = false;
    won.add(winner.id); saveWon(); refreshCount();
    setTimeout(() => { $('cs-wheel-wrap').classList.remove('is-landed'); load(); showQR(); }, 9000);
  }

  // Dispatch to the operator-selected style. Winner is already decided (host
  // GO or the fail-safe below) — the animation is choreographed to land on it.
  function runReveal(winner) {
    if (spinning || !winner) return;
    spinning = true;
    $('cs-draw-k').textContent = 'Drawing a winner…';
    $('cs-reveal').hidden = true;
    if (style === 'reel') { $('cs-wheel-wrap').hidden = true; $('cs-reel').hidden = false; showDraw(); runReel(winner); }
    else { $('cs-reel').hidden = true; $('cs-wheel-wrap').hidden = false; runWheel(winner); }
  }

  function runWheel(winner) {
    const list = displayList(winner);
    const n = list.length, seg = 360 / n;
    const winIdx = Math.max(0, list.findIndex((e) => e.id === winner.id));
    buildWheel(list);                    // rebuilt while the takeover is still hidden
    showDraw();
    const svg = $('cs-wheel-svg'), g = $('cs-wheel');
    g.classList.remove('cs-spread'); void g.getBoundingClientRect(); g.classList.add('cs-spread');   // names spread out from the hub
    // Land the winner's slice centre under the top pointer, after several turns.
    const want = ((-((winIdx + 0.5) * seg)) % 360 + 360) % 360;
    const cur = ((rot % 360) + 360) % 360;
    const jitter = (Math.random() * 0.5 - 0.25) * seg;   // stay well inside the slice
    rot += (5 + (Math.random() * 2 | 0)) * 360 + ((want - cur + 360) % 360) + jitter;
    let done = false;
    const finish = () => { if (done) return; done = true; wheelReveal(winner, winIdx); };
    svg.addEventListener('transitionend', (e) => { if (e.propertyName === 'transform') finish(); }, { once: true });
    setTimeout(finish, 6600);            // safety net if transitionend is missed
    requestAnimationFrame(() => { setTimeout(() => { svg.style.transition = 'transform 5.4s cubic-bezier(.13,.62,.08,1)'; svg.style.transform = `rotate(${rot}deg)`; }, 460); });
  }
  function wheelReveal(winner, winIdx) {
    const slice = $('cs-wheel').querySelector('path[data-i="' + winIdx + '"]');
    if (slice) { slice.setAttribute('fill', '#ffe38a'); slice.classList.add('cs-slice-win'); }
    $('cs-wheel-wrap').classList.add('is-landed');
    $('cs-draw-k').textContent = '🎉 Winner';
    const nameEl = $('cs-name'); nameEl.className = 'cs-name is-winner';
    fitName(nameEl, winner.name);
    $('cs-reveal').hidden = false;
    finishReveal(winner);
  }

  // Name reel: every remaining name streams past and slows onto the winner.
  function runReel(winner) {
    const track = $('cs-track');
    const p = pool(), reps = Math.max(45, p.length + 30), arr = [];
    for (let i = 0; i < reps; i++) arr.push(p.length ? p[(Math.random() * p.length) | 0].name : winner.name);
    const winIndex = arr.length - 7; arr[winIndex] = winner.name;
    track.innerHTML = arr.map((nm, i) => `<div class="cs-card ${i === winIndex ? 'win' : (i % 2 ? 'alt' : '')}">${esc(nm)}</div>`).join('');
    track.style.transition = 'none'; track.style.transform = 'translateX(0)';
    const viewW = track.parentElement.clientWidth;
    const stride = track.children.length > 1 ? (track.children[1].offsetLeft - track.children[0].offsetLeft) : 240;
    const target = -(winIndex * stride + stride / 2 - viewW / 2) + (Math.random() * 30 - 15);
    void track.offsetWidth;
    let done = false;
    const finish = () => { if (done) return; done = true; $('cs-draw-k').textContent = '🎉 Winner'; finishReveal(winner); };
    track.addEventListener('transitionend', (e) => { if (e.propertyName === 'transform') finish(); }, { once: true });
    setTimeout(finish, 6400);
    requestAnimationFrame(() => { track.style.transition = 'transform 5.4s cubic-bezier(.12,.62,.06,1)'; track.style.transform = `translateX(${target}px)`; });
  }

  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY, { auth: { persistSession: false } });
  let channel = null;
  const send = (event, payload) => { try { if (channel) channel.send({ type: 'broadcast', event, payload }); } catch {} };
  if (token) {
    channel = supabase.channel('chamatkar-' + token.slice(0, 16), { config: { broadcast: { self: false } } })
      .on('broadcast', { event: 'go' }, ({ payload }) => runReveal({ id: payload.id, name: payload.name }))
      .on('broadcast', { event: 'putback' }, ({ payload }) => { if (payload && payload.id) { won.delete(payload.id); saveWon(); } load(); })
      .on('broadcast', { event: 'reset' }, () => { won = new Set(); saveWon(); load(); showQR(); })
      .subscribe((s) => { $('cs-sync').textContent = s === 'SUBSCRIBED' ? '●' : '○'; $('cs-sync').classList.toggle('on', s === 'SUBSCRIBED'); });
  }

  // ── Fail-safe: draw straight from the TV if the host phone can't ──────────
  // Picks a random remaining name and spins here; also broadcasts 'go' so any
  // other open screen stays in sync. Same pool, same wheel as the host GO.
  function localDraw() {
    if (spinning) return;
    const p = pool();
    if (!p.length) { const b = $('cs-ops-go'); const t = b.textContent; b.textContent = 'No one to draw yet'; setTimeout(() => { b.textContent = t; }, 1500); return; }
    const w = p[(Math.random() * p.length) | 0];
    send('go', { id: w.id, name: w.name });
    window.scrollTo({ top: 0, behavior: 'auto' });
    runReveal(w);
  }
  $('cs-ops-go').addEventListener('click', localDraw);
  $('cs-style').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) setStyle(b.dataset.s); });
  setStyle(style);
  $('cs-ops-reset').addEventListener('click', () => {
    if (!confirm('Put everyone back in the draw (clear all winners on this screen)?')) return;
    won = new Set(); saveWon(); send('reset', {}); refreshCount(); load();
  });

  setInterval(() => { if (document.visibilityState === 'visible' && !spinning) load(); }, 12000);
  // Same as the host page: the TV can be backgrounded or the venue wifi can
  // drop, and the interval stops without saying so. Re-pull on the way back.
  const revive = () => { if (document.visibilityState === 'visible' && !spinning) load(); };
  document.addEventListener('visibilitychange', revive);
  window.addEventListener('focus', revive);
  window.addEventListener('online', revive);
  load();
</script>

<style>
  .cs { --gold: #ffd24a; --gold-hi: #ffe38a; --magic: #b06bff; --ink: #0a0a0c; --bone: #f4f1e8; --muted: #9a968c;
    min-height: 100dvh; background:
      radial-gradient(80% 60% at 15% 0%, rgba(176,107,255,.15), transparent 55%),
      radial-gradient(70% 60% at 95% 100%, rgba(255,210,74,.12), transparent 55%),
      var(--ink);
    color: var(--bone); font-family: var(--font-body, system-ui, sans-serif); position: relative; overflow: hidden; }

  /* QR state — two columns on a TV */
  .cs-qr { min-height: 100dvh; display: flex; align-items: center; justify-content: center; gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(2rem, 5vw, 4rem); flex-wrap: wrap; }
  .cs-left { max-width: 40rem; }
  .cs-eyebrow { font-weight: 700; letter-spacing: .24em; text-transform: uppercase; color: var(--gold); font-size: clamp(.9rem, 1.6vw, 1.3rem); }
  .cs-title { font-family: var(--font-display, sans-serif); font-size: clamp(4rem, 12vw, 10rem); line-height: .92; margin: .3rem 0 .6rem; text-transform: uppercase;
    background: linear-gradient(180deg, #fff, var(--gold) 62%, #e0a11f); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cs-tag { font-family: var(--font-display, sans-serif); font-size: clamp(1.8rem, 4vw, 3.2rem); text-transform: uppercase; color: var(--bone); margin: 0 0 .8rem; line-height: 1; }
  .cs-sub { color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.7rem); line-height: 1.45; margin: 0 0 1.6rem; max-width: 30ch; }
  .cs-sub b { color: var(--bone); }
  .cs-count { display: flex; align-items: baseline; gap: .8rem; }
  .cs-count b { font-family: var(--font-display, sans-serif); font-size: clamp(3rem, 7vw, 6rem); color: var(--gold); line-height: 1; }
  .cs-count span { font-size: clamp(1rem, 1.8vw, 1.5rem); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }

  .cs-right { display: flex; flex-direction: column; align-items: center; gap: 1.2rem; }
  .cs-qrpanel { background: #fff; border-radius: 28px; padding: clamp(1.4rem, 2.5vw, 2.4rem); box-shadow: 0 40px 100px -20px rgba(0,0,0,.7); }
  .cs-qrpanel canvas { display: block; width: clamp(300px, 34vw, 560px); height: auto; }
  .cs-scan { font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--gold); font-size: clamp(1rem, 1.8vw, 1.5rem); }

  /* Draw takeover */
  .cs-draw { position: relative; min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    padding: clamp(1.4rem, 4vw, 3rem); gap: clamp(1rem, 3vw, 2rem); }
  .cs-draw-k { font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); font-size: clamp(1.4rem, 3vw, 2.4rem); }

  /* Roulette wheel */
  .cs-wheel-wrap { --wsz: min(72vh, 88vw); position: relative; width: var(--wsz); height: var(--wsz); }
  .cs-wheel { width: 100%; height: 100%; display: block; transform-origin: 50% 50%; will-change: transform;
    filter: drop-shadow(0 24px 60px rgba(0,0,0,.55)); }
  .cs-pointer { position: absolute; top: -8px; left: 50%; transform: translateX(-50%); width: 0; height: 0; z-index: 3;
    border-left: 22px solid transparent; border-right: 22px solid transparent; border-top: 36px solid var(--gold);
    filter: drop-shadow(0 4px 6px rgba(0,0,0,.55)); }
  .cs-slice-win { filter: drop-shadow(0 0 14px rgba(255,210,74,.9)); }
  #cs-wheel { transform-origin: 200px 200px; }
  #cs-wheel.cs-spread { animation: cs-spread .5s cubic-bezier(.2,1.1,.3,1) both; }
  @keyframes cs-spread { from { transform: scale(.2); opacity: 0; } to { transform: scale(1); opacity: 1; } }

  /* Name-reel style */
  .cs-reel { width: min(1500px, 96vw); }
  .cs-reelview { position: relative; overflow: hidden; border: 1px solid #241d33; border-radius: 20px;
    background: linear-gradient(180deg, #0e0b14, #0a0810); box-shadow: inset 0 0 70px rgba(0,0,0,.6);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 13%, #000 87%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 13%, #000 87%, transparent); }
  .cs-track { display: flex; will-change: transform; padding: clamp(1.6rem, 3vh, 3rem) 0; }
  .cs-card { flex: 0 0 auto; width: clamp(200px, 24vw, 360px); margin: 0 8px; height: clamp(110px, 15vh, 200px);
    display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 16px; border-radius: 16px;
    font-family: var(--font-display, sans-serif); text-transform: uppercase; line-height: .95; letter-spacing: .02em;
    font-size: clamp(1.8rem, 4vw, 3.6rem); overflow-wrap: anywhere;
    background: linear-gradient(180deg, #191320, #120d1b); border: 1px solid #241d33; color: var(--bone); }
  .cs-card.alt { background: linear-gradient(180deg, #1c1522, #140e1c); }
