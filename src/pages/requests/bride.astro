---
// /requests/bride/?c=<slug>&k=<key> — the couple's OWN private song list.
// Styled to Anjana & Isaiah's wedding suite (Villa Cetinale, Tuscany): ivory +
// burgundy + antique gold, Pinyon Script / Cormorant Garamond / EB Garamond.
// No 3-song cap; the list is read back so they can manage it. Everything writes
// to the same song_requests table (tagged with a secret owner_key). The couple
// can add songs (credited to whichever partner), tag a function, star must-plays,
// attach a reference link, keep a "don't play" list, and delete any entry.
// Privacy: guests can't read the table — reads/edits/deletes go through
// key-scoped security-definer functions. Unlisted, noindex.
const SUPABASE_URL = "https://jftnhuutttmccmqnnybf.supabase.co";
const SUPABASE_KEY = "sb_publishable_ysWygc3QGKbfsUd0f7Evzw__98TEoo9";
// Bespoke header line for this wedding (edit if reused for another couple).
const EVENT_LINE = "Villa Cetinale · Tuscany · 17–20 Oct 2026";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Your Song List</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <script is:inline>(function(){try{var t=localStorage.getItem('brideTheme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
  <style is:global>
    :root{
      --bg:#f5efe4; --card:#fffdf8; --line:#e2d8c7; --field:#ffffff;
      --ink:#241f1b; --ink-soft:#6f6355; --wine:#7a1f2b; --accent:#7a1f2b;
      --gold:#b0895a; --green:#4e7d52; --btn-ink:#fdf6ef;
      --star-off:#c9bda9; --place:#b7ab99;
      --avoid-bg:#fcf5f3; --avoid-line:#e7cfcd; --avoid-ink:#5f1621;
    }
    :root[data-theme="dark"]{
      --bg:#17120f; --card:#221c18; --line:#3a2f27; --field:#1c1713;
      --ink:#f1e8db; --ink-soft:#b3a491; --wine:#a12d3d; --accent:#e6a9b0;
      --gold:#cca768; --green:#82c58c; --btn-ink:#fdf6ef;
      --star-off:#5f5346; --place:#7a6d5d;
      --avoid-bg:#26191a; --avoid-line:#4a3330; --avoid-ink:#e6a9b0;
    }
    *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
    html,body{ margin:0; background:var(--bg); color:var(--ink);
      font-family:'EB Garamond', Georgia, 'Times New Roman', serif; min-height:100dvh; }
    body{ background-image:
      radial-gradient(ellipse 100% 42% at 50% -6%, rgba(122,31,43,.07), transparent 60%),
      radial-gradient(ellipse 120% 50% at 50% 116%, rgba(176,137,90,.08), transparent 72%);
      padding:max(20px,env(safe-area-inset-top)) 18px calc(30px + env(safe-area-inset-bottom)); }
    ::selection{ background:rgba(122,31,43,.16); }
    .wrap{ max-width:470px; margin:0 auto; }

    header{ text-align:center; padding:16px 0 12px; }
    .k{ font-size:11px; letter-spacing:.34em; text-transform:uppercase; color:var(--accent); font-weight:600; }
    .names{ font-family:'Pinyon Script', cursive; font-weight:400; font-size:3.4rem; white-space:nowrap; max-width:100%;
      line-height:1.14; margin:.1rem 0 .05rem; color:var(--ink); padding:0 .04em .12em; }
    .event-line{ font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); margin-top:6px; }
    .ornament{ display:flex; align-items:center; justify-content:center; gap:12px; margin:13px auto 9px; max-width:200px; }
    .ornament::before, .ornament::after{ content:''; height:1px; flex:1; }
    .ornament::before{ background:linear-gradient(90deg, transparent, rgba(176,137,90,.6)); }
    .ornament::after{ background:linear-gradient(90deg, rgba(176,137,90,.6), transparent); }
    .ornament i{ font-style:normal; color:var(--gold); font-size:10px; letter-spacing:.2em; }
    .occ{ font-family:'Cormorant Garamond', serif; font-style:italic; font-size:1.12rem; color:var(--ink-soft); }

    .intro{ text-align:center; color:var(--ink-soft); font-size:1.02rem; line-height:1.7; margin:0 auto 1.4rem; max-width:24rem; }
    .intro em{ font-style:italic; color:var(--accent); }

    .sec-h{ display:flex; justify-content:space-between; align-items:baseline; gap:12px; margin:2.2rem 0 12px;
      padding-bottom:8px; border-bottom:1px solid var(--line); }
    .sec-h > span{ font-family:'Cormorant Garamond', serif; font-style:italic; font-weight:600; font-size:1.3rem; color:var(--ink); }
    .sec-h b{ color:var(--accent); font-weight:600; font-size:13px; }

    .item{ display:flex; align-items:flex-start; gap:10px; background:var(--card); border:1px solid var(--line);
      border-radius:11px; padding:13px; margin:0 0 9px; box-shadow:0 1px 2px rgba(60,40,30,.04);
      transition:border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
    .item:hover{ border-color:rgba(176,137,90,.5); box-shadow:0 6px 20px rgba(60,40,30,.07); }
    .item.must{ border-color:rgba(122,31,43,.38); box-shadow:0 5px 18px rgba(122,31,43,.07); }
    .item.avoid{ border-color:var(--avoid-line); background:var(--avoid-bg); }
    .item.avoid .s{ color:var(--avoid-ink); }
    .star{ flex:none; background:none; border:none; color:var(--star-off); font-size:22px; cursor:pointer; padding:0;
      width:38px; height:38px; display:flex; align-items:center; justify-content:center; transition:color .15s; }
    .star.on{ color:var(--gold); }
    .item .s{ flex:1; min-width:0; font-size:1.05rem; color:var(--ink); word-break:break-word; line-height:1.4; padding-top:6px; }
    .item .who{ font-size:12.5px; color:var(--accent); margin-top:4px; display:flex; flex-wrap:wrap; align-items:center; gap:6px 12px; }
    .reflink{ background:none; border:none; color:var(--gold); font-size:12.5px; font-family:inherit; cursor:pointer; padding:4px 2px; text-decoration:underline; text-underline-offset:2px; }
    .item .rm{ flex:none; background:none; border:1px solid var(--line); color:var(--ink-soft); border-radius:9px;
      width:38px; height:38px; font-size:15px; line-height:1; cursor:pointer; transition:.15s; }
    .item .rm:hover{ border-color:var(--wine); color:var(--wine); }
    .rm .spin{ border-color:rgba(122,31,43,.25); border-top-color:var(--wine); }
    .empty-list{ color:var(--ink-soft); font-size:1rem; text-align:center; padding:.6rem 0 .2rem; font-style:italic; font-family:'Cormorant Garamond',serif; }

    .linkedit{ display:flex; flex-wrap:wrap; gap:6px; margin-top:9px; width:100%; }
    .linkinput{ flex:1 1 160px; min-width:0; background:var(--field); border:1.5px solid var(--line); border-radius:9px;
      padding:9px 11px; color:var(--ink); font-size:15px; outline:none; font-family:inherit; }
    .linkinput:focus{ border-color:var(--wine); box-shadow:0 0 0 3px rgba(122,31,43,.09); }
    .linksave{ background:var(--wine); color:var(--btn-ink); border:none; border-radius:9px; padding:8px 15px; font-size:13px; font-weight:600; font-family:inherit; cursor:pointer; }
    .linksave:disabled{ opacity:.6; }
    .linkcancel{ background:none; border:1px solid var(--line); color:var(--ink-soft); border-radius:9px; padding:8px 13px; font-size:13px; font-family:inherit; cursor:pointer; }

    .who-wrap{ display:flex; flex-wrap:wrap; gap:8px; margin:0 0 12px; }
    .chip{ background:var(--field); border:1.5px solid var(--line); color:var(--ink-soft); border-radius:99px;
      padding:11px 18px; font-size:15px; font-family:inherit; cursor:pointer; transition:.16s; }
    .chip:hover{ border-color:var(--gold); color:var(--ink); }
    .chip.on{ background:var(--wine); border-color:var(--wine); color:var(--btn-ink); font-weight:600; }

    .songrow{ position:relative; margin:0 0 10px; }
    .songrow .n{ position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--gold); font-family:'Cormorant Garamond',serif; font-size:1.2rem; font-weight:600; pointer-events:none; }
    .songrow input{ width:100%; background:var(--field); border:1.5px solid var(--line); border-radius:11px;
      padding:14px 14px 14px 36px; color:var(--ink); font-size:16px; outline:none; font-family:inherit; transition:border-color .16s, box-shadow .16s; }
    .songrow input:focus{ border-color:var(--wine); box-shadow:0 0 0 3px rgba(122,31,43,.09); }
    .songrow input::placeholder{ color:var(--place); }

    .addmore{ background:none; border:none; color:var(--accent); font-size:1rem; font-family:'Cormorant Garamond',serif; font-style:italic; cursor:pointer; padding:2px 0 10px; }
    .go{ width:100%; padding:16px; border:none; border-radius:12px; font-size:14px; font-weight:600;
      letter-spacing:.08em; text-transform:uppercase; color:var(--btn-ink); background:var(--wine); cursor:pointer; margin-top:6px;
      box-shadow:0 8px 22px rgba(122,31,43,.18); transition:filter .18s, transform .18s; }
    .go:hover{ filter:brightness(1.07); transform:translateY(-1px); }
    .go:active{ transform:translateY(0); }
    .go:disabled{ opacity:.55; }
    .go.avoid-go{ background:#6a5f54; box-shadow:0 8px 22px rgba(60,40,30,.14); }

    .msg{ text-align:center; font-size:1.02rem; padding:11px; border-radius:10px; margin:14px 0 0; display:none; font-family:'Cormorant Garamond',serif; font-style:italic; }
    .msg.err{ display:block; background:rgba(122,31,43,.08); color:var(--accent); border:1px solid rgba(122,31,43,.25); }
    .msg.ok{ display:block; background:rgba(78,125,82,.1); color:#3d6b42; border:1px solid rgba(78,125,82,.3); }

    .divider{ border:0; border-top:1px solid var(--line); margin:2.1rem 0 0; }
    .foot{ text-align:center; color:var(--ink-soft); font-size:10px; margin-top:24px; padding-top:16px; border-top:1px solid var(--line); letter-spacing:.2em; text-transform:uppercase; }
    .theme-tog{ position:fixed; top:14px; right:14px; z-index:30; width:40px; height:40px; border-radius:50%;
      background:var(--card); border:1px solid var(--line); color:var(--accent); font-size:17px; line-height:1; cursor:pointer;
      display:flex; align-items:center; justify-content:center; box-shadow:0 2px 10px rgba(0,0,0,.10); transition:border-color .18s, transform .12s; }
    .theme-tog:hover{ border-color:var(--gold); }
    .theme-tog:active{ transform:scale(.94); }

    .state{ text-align:center; padding:2.4rem 1rem; }
    .state .big{ font-family:'Cormorant Garamond',serif; font-style:italic; font-size:2rem; color:var(--ink); margin:.4rem 0 .6rem; }
    .state p{ color:var(--ink-soft); line-height:1.6; }
    .lux-load{ letter-spacing:.32em; text-transform:uppercase; font-size:12px; color:var(--accent); animation:lux 1.6s ease-in-out infinite; }
    @keyframes lux{ 0%,100%{ opacity:.4 } 50%{ opacity:1 } }

    .hidden{ display:none !important; }
    .hp{ position:absolute; left:-9999px; width:1px; height:1px; opacity:0; }
    .spin{ display:inline-block; width:15px; height:15px; border:2px solid rgba(253,246,239,.4); border-top-color:#fdf6ef; border-radius:50%; animation:sp .7s linear infinite; vertical-align:-2px; }
    @keyframes sp{ to{ transform:rotate(360deg); } }
    #app.fade-in{ animation:fadeUp .6s cubic-bezier(.2,.7,.2,1) both; }
    @keyframes fadeUp{ from{ opacity:0; transform:translateY(10px) } to{ opacity:1; transform:none } }
    @media (prefers-reduced-motion: reduce){ #app.fade-in, .lux-load, .spin{ animation:none } }
  </style>
</head>
<body>
  <button id="themeToggle" class="theme-tog" type="button" aria-label="Toggle light or dark theme">☾</button>
  <main class="wrap">
    <div id="loading" class="state"><p class="lux-load">Preparing your list</p></div>

    <div id="invalid" class="state hidden">
      <div class="big">This link isn’t active</div>
      <p>Please use the exact private link DJ VIC shared with you.</p>
    </div>

    <div id="app" class="hidden">
      <header>
        <div class="k">Song List</div>
        <div class="names" id="names">—</div>
        <div class="event-line">{EVENT_LINE}</div>
        <div class="ornament"><i>✦</i></div>
        <div class="occ">your private song list</div>
      </header>
      <p class="intro">Add as many songs as you like, star the must-plays, attach a link for the exact version, and note anything you’d rather <em>not</em> hear. We’ll build the celebration around it.</p>

      <!-- WANT list -->
      <div class="sec-h"><span>Your selections</span><b id="count">0</b></div>
      <div id="list"></div>
      <div id="emptyList" class="empty-list">Nothing added yet — add your first song below.</div>

      <div class="sec-h"><span>Add a song</span></div>
      <div id="who" class="who-wrap hidden"></div>
      <div id="fn" class="who-wrap"></div>
      <form id="f" autocomplete="off" novalidate>
        <input class="hp" type="text" id="company" tabindex="-1" aria-hidden="true" />
        <div id="songs"></div>
        <button type="button" id="addmore" class="addmore">+ Add another row</button>
        <button type="submit" id="go" class="go">Add to my list</button>
      </form>

      <hr class="divider" />

      <!-- AVOID list -->
      <div class="sec-h"><span>Please don’t play</span><b id="avoidCount">0</b></div>
      <div id="avoidList"></div>
      <div id="emptyAvoid" class="empty-list">Add any songs or artists you’d rather not hear.</div>
      <form id="af" autocomplete="off" novalidate>
        <div id="avoidSongs"></div>
        <button type="button" id="avoidMore" class="addmore">+ Add another row</button>
        <button type="submit" id="avoidGo" class="go avoid-go">Add to don’t-play list</button>
      </form>

      <div id="msg" class="msg"></div>
      <div class="foot">Powered by DJ VIC · djvicofficial.com</div>
    </div>
  </main>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var show = function (id) { ['loading','invalid','app'].forEach(function(x){ $(x).classList.toggle('hidden', x!==id); }); };
      var H = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' };

      var params = new URLSearchParams(location.search);
      var slug = (params.get('c') || '').trim().toLowerCase();
      var key  = (params.get('k') || '').trim();
      if (!slug || key.length < 6) { show('invalid'); return; }

      var who = 'Couple';   // whichever partner is adding right now
      var fn  = '';         // optional function tag for the next add

      fetch(SUPABASE_URL + '/rest/v1/request_couples?slug=eq.' + encodeURIComponent(slug) + '&select=couple_names,active', { headers: H })
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (rows) {
          var c = rows && rows[0];
          if (!c || c.active === false) { show('invalid'); return; }
          $('names').textContent = c.couple_names;
          buildWho(c.couple_names);
          buildFunctions();
          buildRows('songs', 3, 'song');
          buildRows('avoidSongs', 2, 'asong');
          show('app');
          $('app').classList.add('fade-in');
          fitName();
          loadList();
        })
        .catch(function () { show('invalid'); });

      // Keep the couple's name on ONE line, as large as fits the screen.
      function fitName() {
        var el = $('names');
        if (!el || !el.textContent || !el.clientWidth) return;
        var size = 76, min = 24, guard = 0;
        el.style.fontSize = size + 'px';
        while (el.scrollWidth > el.clientWidth && size > min && guard < 90) { size -= 1; el.style.fontSize = size + 'px'; guard++; }
      }
      if (document.fonts && document.fonts.ready) { try { document.fonts.ready.then(fitName); } catch (e) {} }
      window.addEventListener('resize', fitName);

      function buildWho(coupleNames) {
        var parts = coupleNames.split(/\s*(?:&|,|\band\b)\s*/i).map(function (s) { return s.trim(); }).filter(Boolean);
        who = (parts[0] || coupleNames || 'Couple').trim();
        if (parts.length < 2) return;
        var host = $('who'); host.innerHTML = '';
        var lbl = document.createElement('span');
        lbl.style.cssText = 'width:100%;font-size:12px;color:var(--ink-soft);margin:0 0 -2px;';
        lbl.textContent = 'Adding as';
        host.appendChild(lbl);
        parts.forEach(function (nm) {
          var b = document.createElement('button'); b.type = 'button';
          b.className = 'chip' + (nm === who ? ' on' : ''); b.textContent = nm;
          b.addEventListener('click', function () {
            who = nm;
            [].slice.call(host.querySelectorAll('.chip')).forEach(function (x) { x.classList.toggle('on', x.textContent === nm); });
          });
          host.appendChild(b);
        });
        host.classList.remove('hidden');
      }

      var FUNCTIONS = ['Cocktail', 'Sangeet', 'Mehndi'];
      function buildFunctions() {
        var host = $('fn'); host.innerHTML = '';
        var lbl = document.createElement('span');
        lbl.style.cssText = 'width:100%;font-size:12px;color:var(--ink-soft);margin:0 0 -2px;';
        lbl.textContent = 'For which function? (optional)';
        host.appendChild(lbl);
        FUNCTIONS.forEach(function (nm) {
          var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = nm;
          b.addEventListener('click', function () {
            fn = (fn === nm) ? '' : nm;
            [].slice.call(host.querySelectorAll('.chip')).forEach(function (x) { x.classList.toggle('on', x.textContent === fn); });
          });
          host.appendChild(b);
        });
      }

      function buildRows(hostId, n, cls) { var host = $(hostId); host.innerHTML = ''; for (var i = 0; i < n; i++) addRowTo(host, i === 0, cls); }
      function addRowTo(host, first, cls) {
        var row = document.createElement('div'); row.className = 'songrow';
        row.innerHTML = '<span class="n">' + (host.children.length + 1) + '</span>';
        var inp = document.createElement('input'); inp.type = 'text'; inp.className = cls;
        inp.placeholder = first ? (cls === 'asong' ? 'Song or artist to avoid' : 'Song name — artist') : 'Another song';
        row.appendChild(inp); host.appendChild(row);
      }

      function loadList() {
        fetch(SUPABASE_URL + '/rest/v1/rpc/bride_list_requests', {
          method: 'POST', headers: H, body: JSON.stringify({ p_slug: slug, p_key: key })
        }).then(function (r) { return r.ok ? r.json() : []; }).then(renderAll).catch(function () { renderAll([]); });
      }

      function renderAll(items) {
        items = Array.isArray(items) ? items : [];
        renderWant(items.filter(function (x) { return !x.is_avoid; }));
        renderAvoid(items.filter(function (x) { return x.is_avoid; }));
      }

      function whoTag(it) { return (it.guest_name || '').replace(/\s*\(couple\)\s*$/i, '').trim(); }

      function renderWant(items) {
        $('count').textContent = String(items.length);
        var host = $('list'); host.innerHTML = '';
        $('emptyList').classList.toggle('hidden', items.length > 0);
        items.forEach(function (it) {
          var row = document.createElement('div'); row.className = 'item' + (it.must_play ? ' must' : '');

          var star = document.createElement('button'); star.type = 'button'; star.className = 'star' + (it.must_play ? ' on' : '');
          star.innerHTML = it.must_play ? '★' : '☆';
          star.title = it.must_play ? 'Must-play — tap to unset' : 'Mark as must-play';
          star.addEventListener('click', function () { star.disabled = true; updateReq(it.id, !it.must_play, it.ref_url || null, function (ok) { star.disabled = false; if (ok) loadList(); }); });

          var col = document.createElement('div'); col.className = 's';
          var s = document.createElement('div'); s.textContent = it.song; col.appendChild(s);

          var w = document.createElement('div'); w.className = 'who';
          var meta = []; var nm = whoTag(it); if (nm) meta.push(nm); if (it.sub_event) meta.push(it.sub_event);
          if (meta.length) w.appendChild(document.createTextNode('— ' + meta.join(' · ')));
          var lk = document.createElement('button'); lk.type = 'button'; lk.className = 'reflink';
          lk.textContent = it.ref_url ? '🔗 edit link' : '＋ add link';
          w.appendChild(lk);
          col.appendChild(w);

          var editor = document.createElement('div'); editor.className = 'linkedit hidden';
          var lin = document.createElement('input'); lin.type = 'url'; lin.className = 'linkinput';
          lin.placeholder = 'Paste Spotify / YouTube link'; lin.value = it.ref_url || '';
          var lsave = document.createElement('button'); lsave.type = 'button'; lsave.className = 'linksave'; lsave.textContent = 'Save';
          var lcancel = document.createElement('button'); lcancel.type = 'button'; lcancel.className = 'linkcancel'; lcancel.textContent = 'Cancel';
          editor.appendChild(lin); editor.appendChild(lsave); editor.appendChild(lcancel);
          col.appendChild(editor);
          lk.addEventListener('click', function () { var opening = editor.classList.contains('hidden'); editor.classList.toggle('hidden'); if (opening) lin.focus(); });
          lcancel.addEventListener('click', function () { lin.value = it.ref_url || ''; editor.classList.add('hidden'); });
          lsave.addEventListener('click', function () {
            var url = lin.value.trim(); lsave.disabled = true; lsave.textContent = 'Saving…';
            updateReq(it.id, it.must_play, url || null, function (ok) { lsave.disabled = false; lsave.textContent = 'Save'; if (ok) loadList(); else msg('Couldn’t save that link — try again.', 'err'); });
          });
          lin.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); lsave.click(); } });

          var b = document.createElement('button'); b.className = 'rm'; b.type = 'button'; b.innerHTML = '🗑'; b.title = 'Delete this song';
          b.addEventListener('click', function () { removeItem(it.id, b); });

          row.appendChild(star); row.appendChild(col); row.appendChild(b);
          host.appendChild(row);
        });
      }

      function renderAvoid(items) {
        $('avoidCount').textContent = String(items.length);
        var host = $('avoidList'); host.innerHTML = '';
        $('emptyAvoid').classList.toggle('hidden', items.length > 0);
        items.forEach(function (it) {
          var row = document.createElement('div'); row.className = 'item avoid';
          var col = document.createElement('div'); col.className = 's';
          var s = document.createElement('div'); s.textContent = it.song; col.appendChild(s);
          var nm = whoTag(it);
          if (nm) { var w = document.createElement('div'); w.className = 'who'; w.textContent = '— ' + nm; col.appendChild(w); }
          var b = document.createElement('button'); b.className = 'rm'; b.type = 'button'; b.innerHTML = '🗑'; b.title = 'Delete this song';
          b.addEventListener('click', function () { removeItem(it.id, b); });
          row.appendChild(col); row.appendChild(b); host.appendChild(row);
        });
      }

      function updateReq(id, must, ref, cb) {
        fetch(SUPABASE_URL + '/rest/v1/rpc/bride_update_request', {
          method: 'POST', headers: H, body: JSON.stringify({ p_id: id, p_slug: slug, p_key: key, p_must_play: must, p_ref_url: ref })
        }).then(function (r) { cb(r.ok); }).catch(function () { cb(false); });
      }

      function removeItem(id, btn) {
        btn.disabled = true; btn.innerHTML = '<span class="spin"></span>';
        fetch(SUPABASE_URL + '/rest/v1/rpc/bride_delete_request', {
          method: 'POST', headers: H, body: JSON.stringify({ p_id: id, p_slug: slug, p_key: key })
        }).then(function (r) { if (!r.ok) throw new Error(); loadList(); })
          .catch(function () { btn.disabled = false; btn.innerHTML = '🗑'; msg('Couldn’t remove that — try again.', 'err'); });
      }

      function msg(t, cls) { var m = $('msg'); m.textContent = t; m.className = 'msg ' + cls; }
      function flash(t) { msg(t, 'ok'); setTimeout(function () { $('msg').className = 'msg'; }, 2600); }

      $('addmore').addEventListener('click', function () { addRowTo($('songs'), false, 'song'); });
      $('avoidMore').addEventListener('click', function () { addRowTo($('avoidSongs'), false, 'asong'); });

      $('f').addEventListener('submit', function (e) {
        e.preventDefault();
        if ($('company').value) return; // honeypot
        var songs = [].slice.call(document.querySelectorAll('.song')).map(function (s) { return s.value.trim(); }).filter(Boolean);
        if (!songs.length) return msg('Add at least one song.', 'err');
        var rows = songs.map(function (song) {
          return { couple_slug: slug, guest_name: (who || 'Couple') + ' (couple)', guest_email: null, song: song, owner_key: key, sub_event: fn || null, is_avoid: false };
        });
        var go = $('go'); go.disabled = true; go.innerHTML = '<span class="spin"></span> Adding…';
        insert(rows, function (ok) {
          go.disabled = false; go.textContent = 'Add to my list';
          if (!ok) return msg('Couldn’t save — check your connection and try again.', 'err');
          buildRows('songs', 3, 'song'); flash(rows.length === 1 ? 'Added ✓' : rows.length + ' songs added ✓'); loadList();
        });
      });

      $('af').addEventListener('submit', function (e) {
        e.preventDefault();
        var songs = [].slice.call(document.querySelectorAll('.asong')).map(function (s) { return s.value.trim(); }).filter(Boolean);
        if (!songs.length) return msg('Add at least one song to avoid.', 'err');
        var rows = songs.map(function (song) {
          return { couple_slug: slug, guest_name: (who || 'Couple') + ' (couple)', guest_email: null, song: song, owner_key: key, is_avoid: true };
        });
        var go = $('avoidGo'); go.disabled = true; go.innerHTML = '<span class="spin"></span> Adding…';
        insert(rows, function (ok) {
          go.disabled = false; go.textContent = 'Add to don’t-play list';
          if (!ok) return msg('Couldn’t save — try again.', 'err');
          buildRows('avoidSongs', 2, 'asong'); flash('Added to the don’t-play list ✓'); loadList();
        });
      });

      function insert(rows, cb) {
        fetch(SUPABASE_URL + '/rest/v1/song_requests', {
          method: 'POST', headers: Object.assign({}, H, { Prefer: 'return=minimal' }), body: JSON.stringify(rows)
        }).then(function (r) { cb(r.ok); }).catch(function () { cb(false); });
      }
    })();
  </script>

  <script is:inline>
    (function () {
      var KEY = 'brideTheme', root = document.documentElement, btn = document.getElementById('themeToggle');
      function label() { var d = root.getAttribute('data-theme') === 'dark'; if (btn) { btn.textContent = d ? '☀' : '☾'; btn.title = d ? 'Switch to light' : 'Switch to dark'; } }
      label();
      if (btn) btn.addEventListener('click', function () {
        var d = root.getAttribute('data-theme') === 'dark', t = d ? 'light' : 'dark';
        if (t === 'dark') root.setAttribute('data-theme', 'dark'); else root.removeAttribute('data-theme');
        try { localStorage.setItem(KEY, t); } catch (e) {}
        label();
      });
    })();
  </script>
</body>
</html>
