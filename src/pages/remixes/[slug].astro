---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const tracks = await getCollection('remixes');
  return tracks.map(track => ({
    params: { slug: track.id },
    props: { track },
  }));
}

const { track } = Astro.props;
const { data: t } = track;

const hasVideo = !!t.youtubeId;
const hasDownload = !!t.mp3Url;

// OG / share + schema image: prefer a custom cover (artwork) when set — even
// for tracks that also have a video, so the shared link previews the cover.
// Else the YouTube thumbnail for showcase tracks; else the default.
const ytThumb = t.artwork
  ? t.artwork
  : (hasVideo ? `https://img.youtube.com/vi/${t.youtubeId}/maxresdefault.jpg` : '/images/og-default.jpg');

// Supabase honours ?download= by setting Content-Disposition: attachment.
// Without it the browser streams the file instead of saving it, because the
// HTML download attribute is ignored cross-origin.
const downloadHref = hasDownload
  ? `${t.mp3Url}?download=${encodeURIComponent(t.downloadName || `DJ VIC - ${t.title}.mp3`)}`
  : '';

// Related tracks — same genre, excluding self
const all = await getCollection('remixes');
const related = all
  .filter(r => r.id !== track.id && r.data.genre.some(g => t.genre.includes(g)))
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);

const typeLabel: Record<string, string> = {
  mashup: 'Mashup',
  remix: 'Remix',
  edit: 'Edit',
  rework: 'Rework',
};

const absThumb = ytThumb.startsWith('http') ? ytThumb : `https://djvicofficial.com${ytThumb}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MusicRecording",
    "name": t.title,
    "description": t.description,
    "thumbnailUrl": absThumb,
    ...(hasVideo ? { "embedUrl": `https://www.youtube.com/embed/${t.youtubeId}` } : {}),
    "byArtist": { "@id": "https://djvicofficial.com/#person" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",    "item": "https://djvicofficial.com/" },
      { "@type": "ListItem", "position": 2, "name": "Remixes", "item": "https://djvicofficial.com/remixes/" },
      { "@type": "ListItem", "position": 3, "name": t.title,   "item": `https://djvicofficial.com/remixes/${track.id}/` }
    ]
  }
];
---

<Layout
  title={`${t.title} — DJ VIC ${typeLabel[t.type] || 'Mashup'}`}
  description={t.description}
  ogTitle={`${t.title} — DJ VIC`}
  ogDescription={t.description}
  ogImage={absThumb}
  noindex={t.noindex}
  schema={schema}
>
  <Nav />

  <main id="main-content">

    <!-- ── Breadcrumb ─────────────────────────────── -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="breadcrumb-inner">
        <a href="/remixes/">Remixes &amp; Mashups</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">{t.title}</span>
      </div>
    </nav>

    <!-- ── Track Header ──────────────────────────── -->
    <section id="track-header">
      <div class="track-inner">
        <div class="track-eyebrow">
          {typeLabel[t.type]} &middot; DJ VIC
        </div>
        <h1 class="track-title">{t.title}</h1>
        {t.artists.length > 0 && (
          <p class="track-artists">
            {t.artists.join(' · ')}
          </p>
        )}
        <div class="track-genre-tags">
          {t.genre.map(g => (
            <span class="genre-tag">{g}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Visual: YouTube embed (showcase) or cover art (download) ── -->
    {hasVideo ? (
      <section id="track-video">
        <div class="track-inner">
          <div class="yt-wrap">
            <iframe
              src={`https://www.youtube.com/embed/${t.youtubeId}`}
              title={t.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </section>
    ) : t.artwork ? (
      <section id="track-video">
        <div class="track-inner">
          <div class="art-wrap">
            <img src={t.artwork} alt={t.title} width="720" height="720" loading="eager" />
          </div>
        </div>
      </section>
    ) : null}

    <!-- ── Description ───────────────────────────── -->
    <section id="track-desc">
      <div class="track-inner track-desc-inner">
        <p class="desc-text">{t.description}</p>

        {hasDownload && (
          <div class="dl-block">
            {hasVideo && t.artwork && (
              <img class="dl-cover" src={t.artwork} alt={`${t.title} — cover art`} width="180" height="180" loading="lazy" />
            )}
            <p class="dl-eyebrow">Free download</p>
            <dl class="dl-spec">
              {t.bpm && <div><dt>BPM</dt><dd>{t.bpm}</dd></div>}
              {t.musicalKey && <div><dt>Key</dt><dd>{t.musicalKey}</dd></div>}
              {t.duration && <div><dt>Length</dt><dd>{t.duration}</dd></div>}
              {t.genre.length > 0 && <div><dt>Genre</dt><dd>{t.genre.join(', ')}</dd></div>}
            </dl>

            <audio controls preload="none" src={t.mp3Url}>
              Your browser can't play audio. Use the download below.
            </audio>

            <a id="download" class="dl-btn" href={downloadHref} data-slug={track.id} data-keyword={t.keyword || ''}>
              Download the MP3{t.fileSize && <span class="dl-size">{t.fileSize}</span>}
            </a>

            <div id="optin" class="dl-optin" hidden>
              <p class="dl-optin-title">Saved. New mixes go out here first.</p>
              <form id="optin-form" class="dl-optin-form">
                <label class="sr-only" for="optin-email">Email address</label>
                <input id="optin-email" type="email" name="email" required autocomplete="email" placeholder="you@email.com" />
                <button type="submit">Add me</button>
              </form>
              <p id="optin-msg" class="dl-optin-msg" role="status" aria-live="polite"></p>
            </div>
          </div>
        )}

        {t.tracks.length > 0 && (
          <div class="track-meta-row">
            <span class="meta-label">Original Tracks</span>
            <span class="meta-value">{t.tracks.join(' · ')}</span>
          </div>
        )}

        {t.audiomackSlug && (
          <div class="audiomack-wrap">
            <p class="am-label">Stream &amp; Download Free</p>
            <iframe
              src={`https://audiomack.com/embed/vrentertainment67/song/${t.audiomackSlug}`}
              width="100%"
              height="252"
              scrolling="no"
              allow="autoplay"
              loading="lazy"
              title={`${t.title} on Audiomack`}
              style="border:0;"
            ></iframe>
          </div>
        )}
      </div>
    </section>

    <!-- ── Related Tracks ────────────────────────── -->
    {related.length > 0 && (
      <section id="track-related">
        <div class="track-inner track-related-inner">
          <div class="section-label">More From DJ VIC</div>
          <h2>More Remixes &amp; Mashups</h2>
          <div class="related-grid">
            {related.map(rel => (
              <a href={`/remixes/${rel.id}/`} class="related-card">
                <div class="related-thumb">
                  <img
                    src={rel.data.youtubeId
                      ? `https://img.youtube.com/vi/${rel.data.youtubeId}/hqdefault.jpg`
                      : (rel.data.artwork || '/images/og-default.jpg')}
                    alt={rel.data.title}
                    loading="lazy"
                    width="480"
                    height="360"
                  />
                  <div class="related-play">
                    <svg viewBox="0 0 68 48" width="40" height="28">
                      <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="var(--gold)"/>
                      <path d="M45 24 27 14v20" fill="#000"/>
                    </svg>
                  </div>
                  <span class="related-type-badge">{typeLabel[rel.data.type]}</span>
                </div>
                <div class="related-body">
                  <h3>{rel.data.title}</h3>
                  <span class="related-cta">Watch &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Bottom CTA ─────────────────────────────── -->
    <section id="track-cta">
      <div class="track-inner track-cta-inner">
        <div class="cta-left">
          <p class="cta-label">Hear more from DJ VIC</p>
          <a href="/remixes/" class="cta-back">← All Remixes &amp; Mashups</a>
        </div>
        <a href="/book/" class="cta-book">Book DJ VIC &rarr;</a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  // Free-download → GA event + reveal email capture → insert into contacts.
  // Insert-only by design (Prefer: ignore-duplicates needs no UPDATE grant).
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  function initRemixDownload() {
    const btn = document.getElementById('download');
    if (!btn || btn.dataset.bound) return;   // no download on this track, or already wired
    btn.dataset.bound = '1';
    const optin = document.getElementById('optin');

    btn.addEventListener('click', () => {
      window.gtag?.('event', 'remix_download', {
        remix_slug: btn.dataset.slug,
        remix_keyword: btn.dataset.keyword,
      });
      optin?.removeAttribute('hidden');
    });

    const form = document.getElementById('optin-form');
    const msg = document.getElementById('optin-msg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('optin-email');
      const submit = form.querySelector('button');
      submit.disabled = true;
      msg.textContent = '';
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/contacts`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({
            email: input.value.trim().toLowerCase(),
            source: 'remix-download',
            source_ref: btn.dataset.slug ?? null,
            consent_marketing: true,
            consented_at: new Date().toISOString(),
          }),
        });
        // 201 = added. 409 = already on the list (unique email) — still a
        // success for the visitor. Plain insert keeps anon strictly
        // insert-only: no SELECT/UPDATE grant, as the brief requires.
        if (!res.ok && res.status !== 409) throw new Error(String(res.status));
        form.hidden = true;
        msg.textContent = "You're on the list.";
        window.gtag?.('event', 'newsletter_signup', { source: 'remix-download' });
      } catch {
        submit.disabled = false;
        msg.textContent = "That didn't save. Try again in a moment.";
      }
    });
  }

  initRemixDownload();
  document.addEventListener('astro:page-load', initRemixDownload);
</script>

<style>
  /* ─── Breadcrumb ──────────────────────────────── */
  .breadcrumb {
    background: #050505;
    border-bottom: 1px solid #111;
  }

  .breadcrumb-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0.85rem 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .breadcrumb-inner a {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb-inner a:hover { color: var(--gold-light); }

  .breadcrumb-inner span {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
  }

  .bc-sep { color: rgba(255,255,255,0.15) !important; }
  .bc-current { color: rgba(255,255,255,0.55) !important; }

  /* ─── Shared layout ───────────────────────────── */
  .track-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 2.5rem;
  }

  /* ─── Track Header ───────────────────────────── */
  #track-header {
    background: #060606;
    border-bottom: 1px solid #111;
  }

  #track-header .track-inner {
    padding-top: 4rem;
    padding-bottom: 3.5rem;
  }

  .track-eyebrow {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }

  .track-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 1;
    color: var(--white);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .track-artists {
    font-size: 0.85rem;
    color: var(--gold);
    font-style: italic;
    letter-spacing: 0.03em;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }

  .track-genre-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .genre-tag {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.3rem 0.75rem;
    transition: border-color 0.2s, color 0.2s;
  }

  .genre-tag:hover {
    border-color: rgba(201,168,76,0.35);
    color: var(--gold);
  }

  /* ─── YouTube embed ──────────────────────────── */
  #track-video {
    background: #060606;
  }

  #track-video .track-inner {
    padding-top: 3rem;
    padding-bottom: 0;
  }

  .yt-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .yt-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* ─── Description ────────────────────────────── */
  #track-desc {
    background: #060606;
    border-bottom: 1px solid #111;
  }

  .track-desc-inner {
    padding-top: 3rem;
    padding-bottom: 3.5rem;
  }

  .desc-text {
    font-size: 1rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.85;
    max-width: 64ch;
    margin: 0 0 2rem;
  }

  .track-meta-row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .meta-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.7;
    white-space: nowrap;
  }

  .meta-value {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.55);
  }

  .audiomack-wrap {
    margin-top: 1rem;
    max-width: 560px;
  }

  .am-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
    opacity: 0.7;
  }

  /* ─── Cover-art hero (download-only tracks) ──── */
  .art-wrap {
    max-width: 480px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: #111;
  }

  .art-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Free-download block ────────────────────── */
  .dl-block {
    margin: 0 0 2.5rem;
    padding: 1.75rem;
    border: 1px solid rgba(201,168,76,0.18);
    background: rgba(201,168,76,0.03);
    border-radius: 6px;
    max-width: 560px;
  }

  .dl-cover {
    display: block;
    width: 180px;
    max-width: 45%;
    aspect-ratio: 1;
    height: auto;
    border-radius: 6px;
    margin: 0 0 1.25rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }

  .dl-eyebrow {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 1.25rem;
  }

  .dl-spec {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0 0 1.5rem;
    padding: 0 0 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .dl-spec dt {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 0.25rem;
  }

  .dl-spec dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--white);
  }

  .dl-block audio {
    width: 100%;
    margin: 0 0 1.25rem;
  }

  .dl-btn {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.85rem 1.75rem;
    background: var(--gold);
    color: #000;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s, transform 0.15s;
  }

  .dl-btn:hover { background: var(--gold-light); transform: translateY(-1px); }
  .dl-btn:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }

  .dl-size {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .dl-optin {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .dl-optin-title {
    margin: 0 0 0.9rem;
    font-size: 0.9rem;
    color: var(--white);
  }

  .dl-optin-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .dl-optin-form input {
    flex: 1 1 14rem;
    padding: 0.7rem 0.9rem;
    border-radius: 3px;
    border: 1px solid rgba(255,255,255,0.14);
    background: #0a0c0a;
    color: var(--white);
    font: inherit;
  }

  .dl-optin-form input:focus { outline: none; border-color: var(--gold); }

  .dl-optin-form button {
    padding: 0.7rem 1.4rem;
    border-radius: 3px;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    font: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .dl-optin-form button:hover { background: var(--gold); color: #000; }
  .dl-optin-form button:disabled { opacity: 0.5; cursor: default; }

  .dl-optin-msg {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.55);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  /* ─── Related ────────────────────────────────── */
  #track-related {
    background: #080808;
    border-top: 1px solid #111;
  }

  .track-related-inner {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .section-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  #track-related h2 {
    color: var(--white);
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    background: #0d0d0d;
    border: 1px solid rgba(255,255,255,0.06);
    text-decoration: none;
    color: var(--white);
    transition: border-color 0.25s, background 0.25s;
    overflow: hidden;
  }

  .related-card:hover {
    border-color: rgba(201,168,76,0.25);
    background: #131313;
  }

  .related-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }

  .related-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .related-card:hover .related-thumb img { transform: scale(1.04); }

  .related-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .related-card:hover .related-play { opacity: 1; }

  .related-type-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-size: 0.45rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #000;
    background: var(--gold);
    padding: 0.2rem 0.5rem;
  }

  .related-body {
    padding: 0.85rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-body h3 {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1.3;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-cta {
    font-size: 0.56rem;
