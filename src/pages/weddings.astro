---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TestimonialsStrip from '../components/TestimonialsStrip.jsx';
import { siteConfig as cfg } from '../config/siteConfig';

// Editor toggles (default on).
const showProcess = true;
const showGuides = true;

const venues = ['JW Marriott', 'The Leela', 'Taj Hotels', 'ITC Hotels', 'Hyatt', 'Novotel', 'Golfshire, Nandi Hills'];

const functions = [
  { name: 'Mehendi & Haldi',       meta: 'Daytime · 2–3 hrs',    desc: 'Acoustic and Bollywood-light sets at conversation volume, scaled to a lawn or a living room.' },
  { name: 'Sangeet Night',         meta: 'The big one · 4–5 hrs', desc: 'Family performances cued and mixed live, choreography tracks edited in advance, then the open floor. Three generations, one running order.' },
  { name: 'Cocktail Evening',      meta: 'Evening · 3–4 hrs',    desc: 'Lounge and deep-house arrival, lifting into crossover as the room fills. Built for people who are still talking.' },
  { name: 'Baraat & Wedding Day',  meta: 'Morning · on location', desc: 'Mobile sound for the procession, live dhol on request, and the timing discipline the ceremony schedule demands.' },
  { name: 'Reception',             meta: 'Headline · 4–6 hrs',   desc: 'The grand entrance, the first dance and the family floor — mixed to picture in the full audio-visual format.' },
  { name: 'After-party',           meta: 'Late · open-ended',    desc: 'Open-format club set for whoever is still standing. Separate rig, separate room.' },
];
const included = [
  'Full professional sound and DJ rig, sized to the venue',
  'Venue AV and sound-team coordination before the date',
  'A planning call and a custom music brief per function',
  'Setlists across Hindi, Punjabi, Kannada, Tamil, Telugu, Malayalam and English',
  'On-site backup equipment and a run sheet shared with your planner',
];
const onRequest = ['Live dhol', 'Saxophone / percussion', 'LED visual wall', 'Custom couple mashup', 'Additional day / function', 'Destination travel'];

const steps = [
  { n: '01', t: 'Check the date', d: 'Send the date, the city and the functions. You get a yes or no on availability, usually the same day.' },
  { n: '02', t: 'Planning call', d: 'VIC walks through each function — the families, the languages, the performances, the must-plays and the never-plays.' },
  { n: '03', t: 'Run sheet', d: 'A per-function music brief and cue sheet goes to you and your planner, so nothing is improvised on the day.' },
  { n: '04', t: 'The night', d: 'VIC arrives early, sound-checks with the venue, and plays the room in front of him rather than a template.' },
];

const videos = [
  { id: 'bFWIs4dhvew', caption: 'Prachi & Mridhul',        place: 'Wedding Vlog · Wayanad',                        cat: 'Wedding Films' },
  { id: 'sebNDm7uiWQ', caption: 'Visaaly & Sharan',        place: 'Destination Wedding · Colombo',                 cat: 'Wedding Films' },
  { id: 'Dw5gerVqA7w', caption: 'Kanchana & Nihar',        place: 'Couple testimonial',                           cat: 'Couples Speak' },
  { id: 'x9Q_nA4820w', caption: 'Diksha & Pranav',         place: 'Couple testimonial',                           cat: 'Couples Speak' },
  { id: 'UCVpbps9hrk', caption: 'Raksha & Rahul',          place: 'Couple testimonial',                           cat: 'Couples Speak' },
  { id: 'TU_R42SDuns', caption: 'Wedding showcase',        place: 'Reception & dancefloor',                       cat: 'The Set' },
  { id: '3FJl0cbpOYY', caption: 'Audio-visual pool party', place: 'JW Marriott, Golfshire · Nandi Hills',         cat: 'The Set' },
];
const videoCats = ['All', 'Wedding Films', 'Couples Speak', 'The Set'];
const catCount = (c) => (c === 'All' ? videos.length : videos.filter((v) => v.cat === c).length);

const weddingFaqs = [
  { q: 'How far in advance should we book?', a: 'For peak season — October to February, and April to May — six to twelve months ahead is right. VIC takes a limited number of weddings a month, so Saturdays go first. Reach out as soon as you have a date.' },
  { q: 'Do you cover sangeet, cocktail and the reception?', a: 'Yes, and they are planned as three different nights. Each gets its own set, energy curve and run sheet. Multi-function bookings are the norm rather than the exception.' },
  { q: 'Do you play South Indian and regional music?', a: 'Yes. Bengaluru weddings bring every family together and the floor should too. VIC reads the room across Kannada, Tamil, Telugu and Malayalam alongside the Bollywood and Punjabi crossover the cousins will demand, plus retro for the uncles. We play the family in front of us, not a template.' },
  { q: 'Can we choose the music?', a: 'Completely. The setlist is built from your brief — must-plays, never-plays, family performance tracks and the first dance. VIC edits performance mixes in advance so choreography lands on the beat.' },
  { q: 'Do you travel for destination weddings?', a: 'Yes. VIC has played weddings across India and in 18 countries, including Sri Lanka, Australia and the UK. Travel, freight and venue logistics are quoted with the booking.' },
  { q: 'Do you bring your own equipment?', a: 'Yes — a full professional setup, sized to the venue, with on-site backup. VIC coordinates with the venue sound and AV team before the date so nothing is discovered on the day.' },
  { q: 'What makes this different from other wedding DJs?', a: 'The audio-visual format: original music cut to custom visuals, mixed live. Developed since 2007 and refined across 300+ weddings. The music is treated as the emotional spine of the night, not background.' },
];

// Reviews fallback (DB-managed via /admin → Reviews; category="wedding").
const weddingReviews = [
  { quote: "Vic absolutely nailed our wedding! From the cocktail night to the reception, he read the room perfectly and kept everyone on the dancefloor all night. Couldn't have asked for better energy.", name: 'Sarthak', event: 'Groom · Dec 2024 · Kochi', rating: 5 },
  { quote: 'VIC played for my special day recently, and rocked our cocktail night! Being a North-South wedding, he chose the perfect energetic tunes to keep our guests going on the floor!', name: 'Rashmi Jaiswal', event: 'Bride · Jan 2025 · Bangalore', rating: 5 },
  { quote: 'I think no one left the dancefloor while Vic was playing! He executed the perfect blend of English and Bollywood songs for my entire wedding functions and it was spot on!', name: 'Aryaman', event: 'Groom · July 2025 · Bangalore', rating: 5 },
  { quote: 'VIC was recommended by my cousin and livened up our wedding parties with his music selection and engaging performances. A special mention on the live baraat with dhol performance!!', name: 'Kruthi Singar', event: 'Bride · Dec 2023 · Bangalore', rating: 5 },
  { quote: "Working with Vic on multiple weddings has been seamless every time. He's professional, well-prepared, and genuinely elevates the experience. Highly recommended for any event.", name: 'Manish Fitkariwala', event: 'Wedding Planner · Catapultt', rating: 5 },
];

const guestBands = ['Under 150', '150–300', '300–600', '600–1,000', '1,000+'];
const functionChips = ['Mehendi / Haldi', 'Sangeet', 'Cocktail', 'Baraat', 'Reception', 'After-party'];

// FAQPage schema generated from the same array that renders the list (keeps them in sync).
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: weddingFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Wedding DJ',
  provider: { '@id': 'https://djvicofficial.com/#person' },
  areaServed: ['Bangalore', 'India', 'International'],
  description: `Wedding DJ services across India and internationally — sangeet, cocktail, reception and destination weddings. ${cfg.weddings} weddings performed since ${cfg.careerStart}.`,
  url: 'https://djvicofficial.com/weddings/',
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://djvicofficial.com/' },
    { '@type': 'ListItem', position: 2, name: 'Wedding DJ', item: 'https://djvicofficial.com/weddings/' },
  ],
};
---

<Layout
  title="Wedding DJ Bangalore | Luxury Wedding DJ | DJ VIC"
  description={`DJ VIC performs at weddings across India — sangeet nights, receptions, and destination weddings. ${cfg.yearsActive}+ years, ${cfg.weddings} weddings performed. Enquire now.`}
  schema={[serviceSchema, faqSchema, breadcrumb]}
>
  <Nav />
  <main id="main-content" class="wd">

    <!-- 1 · Hero -->
    <section class="wd-hero" data-img-slot="weddings.hero" style="background-image: linear-gradient(180deg, rgba(5,10,8,.55), rgba(5,10,8,.86)), url('/images/home/wed-hero-placeholder.jpg')">
      <div class="wd-hero-inner">
        <span class="wd-eyebrow">Wedding DJ · Sangeet · Reception · Destination</span>
        <h1 class="wd-hero-h1">Not a playlist.<br/>A night your family remembers.</h1>
        <p class="wd-hero-sub">One DJ across every function — mehendi to the last dance — reading a room that spans three generations and four languages.</p>
        <p class="wd-hero-meta">{cfg.weddings} weddings · Pan-India &amp; destination · Since {cfg.careerStart}</p>
        <div class="wd-hero-cta">
          <a class="wd-btn wd-btn--gold" href="#enquire" data-hero-cta>Check your date &rarr;</a>
          <a class="wd-btn wd-btn--ghost" href="#covered">What's covered</a>
        </div>
      </div>
    </section>

    <!-- 2 · Proof bar -->
    <section class="wd-proof">
      <div class="wd-inner">
        <div class="wd-stats">
          <div class="wd-stat"><strong>{cfg.weddings}</strong><span>Weddings performed</span></div>
          <div class="wd-stat"><strong>{cfg.countries}</strong><span>Countries</span></div>
          <div class="wd-stat"><strong>Est. {cfg.careerStart}</strong><span>Nineteen seasons in</span></div>
          <div class="wd-stat"><strong>{cfg.performances}</strong><span>Nights performed</span></div>
        </div>
        <div class="wd-venues">
          <span class="wd-venues-label">Played weddings at</span>
          <div class="wd-venues-row">{venues.map((v) => <span class="wd-venue">{v}</span>)}</div>
        </div>
      </div>
    </section>

    <!-- 3 · Every function, covered -->
    <section id="covered" class="wd-block wd-covered">
      <div class="wd-inner">
        <div class="wd-head"><span class="wd-rule"></span><span class="wd-eyebrow">What you're booking</span><h2 class="wd-h2">Every function, covered</h2></div>
        <p class="wd-lead">Book the whole celebration or a single night. Each function gets its own set, its own energy, and its own run sheet.</p>
        <div class="wd-covered-grid">
          <div class="wd-functions">
            {functions.map((f) => (
              <div class="wd-func">
                <div class="wd-func-top"><h3 class="wd-func-name">{f.name}</h3><span class="wd-func-meta">{f.meta}</span></div>
                <p class="wd-func-desc">{f.desc}</p>
              </div>
            ))}
          </div>
          <aside class="wd-aside">
            <img class="wd-aside-img" src="/images/home/wed-functions-placeholder.jpg" data-img-slot="weddings.functions" alt="DJ VIC at a wedding function" loading="lazy" width="800" height="1000" />
            <div class="wd-incl">
              <span class="wd-incl-label">Included as standard</span>
              <ul>{included.map((i) => <li>{i}</li>)}</ul>
              <span class="wd-incl-label wd-incl-label--req">On request</span>
              <div class="wd-req-chips">{onRequest.map((r) => <span class="wd-req-chip">{r}</span>)}</div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    {showProcess && (
      <section class="wd-block wd-process">
        <div class="wd-inner">
          <div class="wd-head"><span class="wd-rule"></span><span class="wd-eyebrow">How it works</span><h2 class="wd-h2">From enquiry to the last song</h2></div>
          <div class="wd-steps">
            {steps.map((s) => (
              <div class="wd-step"><span class="wd-step-n">{s.n}</span><h3 class="wd-step-t">{s.t}</h3><p class="wd-step-d">{s.d}</p></div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 5 · Real weddings, on film -->
    <section class="wd-block wd-films">
      <div class="wd-inner">
        <div class="wd-head"><span class="wd-rule"></span><span class="wd-eyebrow">Watch</span><h2 class="wd-h2">Real weddings, on film</h2></div>
        <div class="wd-filters" role="tablist">
          {videoCats.map((c, i) => (
            <button type="button" class={`wd-filter${i === 0 ? ' on' : ''}`} data-filter={c}>{c} <span class="wd-filter-n">{catCount(c)}</span></button>
          ))}
        </div>
        <div class="wd-video-grid" id="wd-video-grid">
          {videos.map((v) => (
            <button type="button" class="wd-vcard" data-cat={v.cat} data-video={v.id} aria-label={`Play ${v.caption}`}>
              <div class="wd-vthumb">
                <img src={`https://img.youtube.com/vi/${v.id}/hqdefault.jpg`} alt={v.caption} loading="lazy" width="480" height="270" />
                <span class="wd-vplay" aria-hidden="true">&#9658;</span>
              </div>
              <div class="wd-vmeta"><span class="wd-vcaption">{v.caption}</span><span class="wd-vplace">{v.place}</span></div>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- 6 · Testimonials -->
    <section class="wd-block wd-testi">
      <div class="wd-inner">
        <div class="wd-head"><span class="wd-rule"></span><span class="wd-eyebrow">Client voices</span><h2 class="wd-h2">What the couples say</h2></div>
        <TestimonialsStrip client:visible category="wedding" fallback={weddingReviews} />
      </div>
    </section>

    <!-- 7 · Destination & NRI -->
    <section class="wd-block wd-dest">
      <div class="wd-inner wd-dest-grid">
        <div class="wd-dest-copy">
          <div class="wd-head"><span class="wd-rule"></span><span class="wd-eyebrow">Destination &amp; NRI weddings</span><h2 class="wd-h2">Your wedding isn't in Bangalore? Neither is the boundary.</h2></div>
          <p class="wd-lead">VIC has performed at weddings across India and internationally — Goa, Udaipur, Kochi, Wayanad, Colombo, the UK and Australia. Destination, NRI or multi-city: the travel, the gear and the venue coordination are handled directly.</p>
          <div class="wd-dest-chips">{['Pan-India', 'Sri Lanka', 'Australia', 'United Kingdom', 'And more'].map((c) => <span class="wd-dest-chip">{c}</span>)}</div>
          <a class="wd-btn wd-btn--gold" href="#enquire">Enquire for your destination &rarr;</a>
        </div>
        <img class="wd-dest-img" src="/images/home/wed-destination-placeholder.jpg" data-img-slot="weddings.destination" alt="Destination wedding" loading="lazy" width="1000" height="800" />
      </div>
    </section>

    <!-- 8 · FAQ -->
    <section class="wd-block wd-faq">
      <div class="wd-inner">
        <div class="wd-head"><span class="wd-rule"></span><span class="wd-eyebrow">Common questions</span><h2 class="wd-h2">Wedding DJ FAQ</h2></div>
        <div class="wd-faq-grid">
          {weddingFaqs.map((f, i) => (
            <details class={`wd-faq-item${i === weddingFaqs.length - 1 ? ' wide' : ''}`}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {showGuides && (
      <section class="wd-block wd-guides">
        <div class="wd-inner">
          <div class="wd-head"><span class="wd-rule"></span><span class="wd-eyebrow">Planning guides</span></div>
          <p class="wd-lead">Working out the budget, or planning away from home? Two honest guides: what a Bangalore wedding DJ actually costs, and how to brief a DJ for a destination wedding.</p>
          <div class="wd-guide-links">
            <a class="wd-guide" href="/blog/wedding-dj-cost-bangalore-2026/">Cost guide &rarr;</a>
            <a class="wd-guide" href="/blog/destination-wedding-dj-india/">Destination guide &rarr;</a>
          </div>
        </div>
      </section>
    )}

    <!-- 10 · Enquiry -->
    <section id="enquire" class="wd-enquire">
      <div class="wd-inner">
        <div class="wd-head"><span class="wd-rule"></span><span class="wd-eyebrow">Check your date</span><h2 class="wd-h2">Tell VIC about the wedding</h2></div>
        <p class="wd-lead">Dates for October through February go early. Send the date and the functions — every enquiry is read personally, no agency in between.</p>
        <div class="wd-enquire-grid">
          <div class="wd-enquire-left">
            <div class="wd-assur">
              <div class="wd-assur-cell"><span class="wd-assur-label">Response</span><span class="wd-assur-val">Every enquiry answered within 24 hours, by VIC.</span></div>
              <div class="wd-assur-cell"><span class="wd-assur-label">Coverage</span><span class="wd-assur-val">Bangalore, pan-India and international. Destination logistics handled directly.</span></div>
              <div class="wd-assur-cell"><span class="wd-assur-label">Peak season</span><span class="wd-assur-val">October–February dates are confirmed first come, first served.</span></div>
            </div>
            <a class="wd-wa" href="https://wa.me/919611711677" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              Message on WhatsApp
            </a>
            <div class="wd-direct">
              <a href="mailto:bookings@djvicofficial.com">bookings@djvicofficial.com</a>
              <a href="tel:+919611711677">+91 96117 11677</a>
            </div>
          </div>

          <div class="wd-enquire-right">
            <form id="wd-form" class="wd-form" novalidate>
              <div class="wd-form-row">
                <div class="wd-field"><label for="wd-name">Your name <span class="wd-req">*</span></label><input type="text" id="wd-name" name="name" placeholder="Full name" required /></div>
                <div class="wd-field"><label for="wd-phone">Phone / WhatsApp <span class="wd-req">*</span></label><input type="tel" id="wd-phone" name="phone" placeholder="+91 98765 43210" required /></div>
              </div>
              <div class="wd-form-row">
                <div class="wd-field"><label for="wd-email">Email</label><input type="email" id="wd-email" name="email" placeholder="your@email.com" /></div>
                <div class="wd-field"><label for="wd-date">Wedding date</label><input type="date" id="wd-date" name="date" /></div>
              </div>
              <div class="wd-form-row">
                <div class="wd-field"><label for="wd-guests">Guests (approx.)</label>
                  <select id="wd-guests" name="guests"><option value="" disabled selected>Select</option>{guestBands.map((g) => <option value={g}>{g}</option>)}</select></div>
                <div class="wd-field"><label for="wd-venue">City or venue</label><input type="text" id="wd-venue" name="venue" placeholder="Bangalore, or the venue name" /></div>
              </div>
              <div class="wd-field">
                <label>Functions you need</label>
                <div class="wd-fn-chips">{functionChips.map((f) => <button type="button" class="wd-fn-chip" data-fn={f}>{f}</button>)}</div>
              </div>
              <div class="wd-field"><label for="wd-details">Anything else</label><textarea id="wd-details" name="details" rows="3" placeholder="Languages the floor will want, family performances, the vibe you're after."></textarea></div>
              <input type="text" name="_company" id="wd-hp" style="display:none" tabindex="-1" autocomplete="off" />
              <button type="submit" id="wd-submit" class="wd-btn wd-btn--gold wd-form-submit">Send enquiry &rarr;</button>
              <p class="wd-form-msg" id="wd-msg" hidden></p>
              <p class="wd-form-fine">Prefer to look around first? See the <a href="/photos/">gallery</a> or the <a href="/audio-visual-dj/">audio-visual format</a>.</p>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Mobile sticky CTA -->
  <a class="wd-sticky" href="#enquire" id="wd-sticky" hidden>Check your date &rarr;</a>

  <!-- Video lightbox -->
  <div class="wd-lightbox" id="wd-lightbox" hidden>
    <button class="wd-lb-close" id="wd-lb-close" type="button" aria-label="Close">&times;</button>
    <div class="wd-lb-frame" id="wd-lb-frame"></div>
  </div>

  <Footer />
</Layout>

<script>
  // Video filter + lightbox
  const grid = document.getElementById('wd-video-grid');
  const filters = document.querySelectorAll('.wd-filter');
  filters.forEach((btn) => btn.addEventListener('click', () => {
    filters.forEach((b) => b.classList.remove('on'));
    btn.classList.add('on');
    const f = btn.getAttribute('data-filter');
    grid?.querySelectorAll('.wd-vcard').forEach((c) => {
      c.hidden = !(f === 'All' || c.getAttribute('data-cat') === f);
    });
  }));

  const lb = document.getElementById('wd-lightbox');
  const lbFrame = document.getElementById('wd-lb-frame');
  function openLb(id) {
    if (!lb || !lbFrame) return;
    lbFrame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Wedding video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    lb.hidden = false; document.body.style.overflow = 'hidden';
  }
  function closeLb() { if (!lb || !lbFrame) return; lb.hidden = true; lbFrame.innerHTML = ''; document.body.style.overflow = ''; }
  grid?.querySelectorAll('.wd-vcard').forEach((c) => c.addEventListener('click', () => openLb(c.getAttribute('data-video'))));
  document.getElementById('wd-lb-close')?.addEventListener('click', closeLb);
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lb && !lb.hidden) closeLb(); });

  // Function chips (multi-select)
  document.querySelectorAll('.wd-fn-chip').forEach((c) => c.addEventListener('click', () => c.classList.toggle('on')));

  // Mobile sticky CTA — appears once the hero CTA scrolls away
  const sticky = document.getElementById('wd-sticky');
  const heroCta = document.querySelector('[data-hero-cta]');
  if (sticky && heroCta && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries) => { sticky.hidden = entries[0].isIntersecting; }, { rootMargin: '-40px 0px 0px 0px' }).observe(heroCta);
  }

  // Enquiry form → submit_booking (event type is always 'wedding' here)
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const NTFY = 'djvic-bookings-7k9f3hQ2pX8mN5vR';
  const form = document.getElementById('wd-form');
  function msg(text, ok) { const m = document.getElementById('wd-msg'); if (!m) return; m.textContent = text; m.hidden = false; m.className = 'wd-form-msg ' + (ok ? 'ok' : 'err'); }
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (id) => (document.getElementById(id)?.value || '').trim();
      if (document.getElementById('wd-hp')?.value) { msg('Thanks — enquiry received.', true); return; }
      const name = val('wd-name'), phone = val('wd-phone');
      if (!name || !phone) { msg('Add your name and a number VIC can reach you on.', false); return; }
      const btn = document.getElementById('wd-submit');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      const fns = [...document.querySelectorAll('.wd-fn-chip.on')].map((c) => c.getAttribute('data-fn'));
      const email = val('wd-email'), date = val('wd-date'), guests = val('wd-guests'), venue = val('wd-venue'), details = val('wd-details');
      const message = [
        fns.length ? `Functions: ${fns.join(', ')}` : '',
        guests ? `Guests: ${guests}` : '',
        details, email ? `Email: ${email}` : '', 'Source: Weddings page',
      ].filter(Boolean).join('\n');
      try {
        const r = await fetch(`${SB_URL}/rest/v1/rpc/submit_booking`, {
          method: 'POST',
          headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_name: name, p_contact: phone, p_event_type: 'wedding', p_event_date: date || null, p_venue: venue || null, p_city: venue || null, p_budget: null, p_message: message }),
        });
        if (!r.ok) throw new Error(await r.text());
        try { navigator.sendBeacon(`https://ntfy.sh/${NTFY}?title=${encodeURIComponent('💍 Wedding enquiry — ' + name)}&priority=4&tags=tada`, new Blob([`${name}${date ? ' · ' + date : ''}${venue ? ' · ' + venue : ''}\n${phone}`], { type: 'text/plain' })); } catch (e) {}
        if (typeof window.trackLead === 'function') window.trackLead('wedding');
        form.reset();
        document.querySelectorAll('.wd-fn-chip.on').forEach((c) => c.classList.remove('on'));
        msg('Enquiry sent. VIC will get back to you within 24 hours — check WhatsApp.', true);
      } catch (err) {
        msg("Couldn't send just now — please message on WhatsApp and I'll sort it out.", false);
        if (btn) { btn.disabled = false; btn.textContent = 'Send enquiry →'; }
      }
    });
  }
</script>

