---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import VicFixListing from '../components/VicFixListing.jsx';
import { getEpisodes, CATEGORIES } from '../lib/vicfix.js';

// Single source of truth for the catalogue (season desc, episode desc → newest first).
const eps = await getEpisodes();

// Build-time "today" (IST) decides latest-published vs upcoming for the static hero.
const todayISO = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
const isPub = (e) => !e.date || e.date <= todayISO;
const published = eps.filter(isPub);
const latest = published[0] || eps[0];
const upcoming = eps.filter((e) => e.date && e.date > todayISO).sort((a, b) => a.date.localeCompare(b.date));
const nextUp = upcoming[0] || null;

const seasonsCount = new Set(eps.map((e) => e.s)).size;
const epCode = (e) => `S${e.s} · E${e.n}`;
const fmtDate = (iso) => (iso ? new Date(iso + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');

// "Start with these three" — editorial trio, one per major strand. Slugs +
// custom framing copy; the rest of the data comes from the episode files.
const CURATED = [
  { id: 'carlton-braganza',   copy: 'He built the venue Bangalore went into mourning over when it closed. He closed it himself.' },
  { id: 'dj-xirex',           copy: 'From a phone and an aux cable to 7 million views — he figured it out without waiting for permission.' },
  { id: 'manish-fitkariwala', copy: 'Behind every perfect wedding, someone ran the show with invisible precision.' },
];
const curated = CURATED.map((c) => { const ep = eps.find((e) => e.slug === `/thevicfix/${c.id}/`); return ep ? { ...ep, copy: c.copy } : null; }).filter(Boolean);
---

<Layout
  title="The VIC Fix Podcast | India Nightlife Culture | DJ VIC"
  description="The VIC Fix is DJ VIC's long-form podcast on India's nightlife culture. Unfiltered conversations with DJs, founders, and artists. 2 seasons on YouTube."
  ogTitle="The VIC Fix — India's Nightlife Stories, Unfiltered"
  ogDescription={`${eps.length} long-form conversations with the DJs, founders, venue owners, and artists shaping India's nightlife and music culture. Hosted by DJ VIC. Now in Season 2.`}
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      "name": "The VIC Fix",
      "description": "India's nightlife and culture podcast hosted by DJ VIC. Unfiltered conversations with DJs, founders, and artists.",
      "url": "https://djvicofficial.com/thevicfix/",
      "author": { "@id": "https://djvicofficial.com/#person" },
      "inLanguage": "en-IN",
      "genre": ["Music", "Culture", "Nightlife", "Entertainment"]
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",        "item": "https://djvicofficial.com/" },
        { "@type": "ListItem", "position": 2, "name": "The VIC Fix", "item": "https://djvicofficial.com/thevicfix/" }
      ]
    }
  ]}
>
  <Nav />
  <main id="main-content" class="vfx-page">

    <!-- ── 1 · Hero ─────────────────────────────────────────────────── -->
    <section class="vf-hero">
      <div class="vf-hero-grid">
        <div class="vf-hero-left">
          <span class="vf-eyebrow">The Podcast · Season {seasonsCount} Live</span>
          <h1 class="vf-h1">The VIC Fix</h1>
          <p class="vf-tagline">Real stories. Real culture. Real nightlife.</p>
          <p class="vf-body">Long-form conversations with the DJs, venue owners, founders and bartenders who built India's nightlife. Hosted by DJ VIC, recorded in Bangalore.</p>
          <div class="vf-cta">
            <a class="vf-btn vf-btn--gold" href="https://www.youtube.com/@thedjvicofficial" target="_blank" rel="noopener noreferrer">Subscribe on YouTube</a>
            <a class="vf-btn vf-btn--ghost" href="https://open.spotify.com/show/1pX6JpyY7oeZ6b2W6spZgw" target="_blank" rel="noopener noreferrer">Spotify</a>
          </div>
          <div class="vf-stats">
            <div class="vf-stat"><strong>{eps.length}</strong><span>Episodes</span></div>
            <div class="vf-stat"><strong>{seasonsCount}</strong><span>Seasons</span></div>
            <div class="vf-stat"><strong>2025</strong><span>Since</span></div>
          </div>
        </div>

        <div class="vf-hero-right">
          {latest && (
            <a class="vf-latest" href={latest.slug}>
              <div class="vf-latest-thumb">
                {latest.thumb && <img src={latest.thumb} alt={`${latest.name} — The VIC Fix`} width="640" height="360" loading="eager" />}
                <div class="vf-latest-badges">
                  <span class="vf-badge-solid">{epCode(latest)}</span>
                  <span class="vf-badge-out">{latest.catLabel}</span>
                </div>
                <div class="vf-latest-over">
                  <span class="vf-latest-name">{latest.name}</span>
                  <span class="vf-latest-role">{latest.role}</span>
                </div>
              </div>
              <p class="vf-latest-hook">{latest.hook}</p>
              <div class="vf-latest-foot">
                <span class="vf-latest-read">Read the episode &rarr;</span>
                <span class="vf-latest-date">{fmtDate(latest.date)}</span>
              </div>
            </a>
          )}
          {nextUp && (
            <div class="vf-nextup">
              <span class="vf-nextup-chip">Next up</span>
              <span class="vf-nextup-text">{epCode(nextUp)} — {nextUp.name}. Premieres {nextUp.premiere || fmtDate(nextUp.date)}.</span>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ── 2 · Start with these three ───────────────────────────────── -->
    {curated.length > 0 && (
      <section class="vf-start">
        <div class="vf-start-inner">
          <div class="vf-start-head">
            <div class="vf-head">
              <span class="vf-rule"></span>
              <span class="vf-eyebrow">New here</span>
              <h2 class="vf-h2">Start with these three</h2>
            </div>
            <p class="vf-start-note">A venue founder, a DJ and a wedding planner — the three shapes most episodes take.</p>
          </div>
          <div class="vf-start-grid">
            {curated.map((e) => (
              <a class="vf-scard" href={e.slug}>
                <div class="vf-scard-thumb">
                  {e.thumb && <img src={e.thumb} alt={`${e.name} — The VIC Fix`} width="480" height="270" loading="lazy" />}
                  <span class="vf-badge-solid vf-scard-code">{epCode(e)}</span>
                </div>
                <div class="vf-scard-body">
                  <span class="vf-scard-strand">{e.catLabel}</span>
                  <span class="vf-scard-name">{e.name}</span>
                  <span class="vf-scard-role">{e.role}</span>
                  <span class="vf-scard-copy">{e.copy}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── 3–5 · Strand guide + toolbar + episode list (interactive) ─── -->
    <VicFixListing client:load episodes={eps} strands={CATEGORIES} />

    <!-- ── 6 · About the show ───────────────────────────────────────── -->
    <section class="vf-about">
      <div class="vf-about-grid">
        <div class="vf-about-left">
          <div class="vf-head">
            <span class="vf-rule"></span>
            <span class="vf-eyebrow">About the show</span>
            <h2 class="vf-h2">Beyond the music</h2>
          </div>
          <p class="vf-about-p">Hosted by DJ VIC — nearly two decades in nightlife across 18 countries — The VIC Fix documents the people, places and moments that shaped India's after-dark culture. DJs, bartenders, venue founders, promoters, artists: the ones who built the scene, told in their own words.</p>
          <p class="vf-about-p">Off the mic, that same instinct for reading a room drives VIC's live work — from <a href="/weddings/">wedding sangeets</a> to <a href="/corporate/">corporate stages</a>, staged as a signature <a href="/audio-visual-dj/">audio-visual show</a>.</p>
        </div>
        <div class="vf-about-right">
          <div class="vf-platforms">
            <a class="vf-plat" href="https://www.youtube.com/@thedjvicofficial" target="_blank" rel="noopener noreferrer"><span class="vf-plat-name">YouTube</span><span class="vf-plat-handle">@thedjvicofficial &rarr;</span></a>
            <a class="vf-plat" href="https://open.spotify.com/show/1pX6JpyY7oeZ6b2W6spZgw" target="_blank" rel="noopener noreferrer"><span class="vf-plat-name">Spotify</span><span class="vf-plat-handle">The VIC Fix &rarr;</span></a>
            <a class="vf-plat" href="https://www.instagram.com/thevicfix" target="_blank" rel="noopener noreferrer"><span class="vf-plat-name">Instagram</span><span class="vf-plat-handle">@thevicfix &rarr;</span></a>
          </div>
          <blockquote class="vf-quote">
            <p>Thanks bro for bringing these podcast sessions. This is exactly the kind of content the nightlife scene here needed.</p>
            <cite>Asad · Viewer</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ── 7 · Guest application ────────────────────────────────────── -->
    <section id="apply" class="vf-apply">
      <div class="vf-apply-grid">
        <div class="vf-apply-left">
          <div class="vf-head">
            <span class="vf-rule"></span>
            <span class="vf-eyebrow">Be a guest</span>
            <h2 class="vf-h2">Want to be on The VIC Fix?</h2>
          </div>
          <p class="vf-apply-body">If you're a DJ, artist, venue founder, bartender, promoter, or anyone who has shaped India's nightlife culture — this show is for you.</p>
          <ul class="vf-criteria">
            <li>You've got a story worth telling</li>
            <li>You're connected to music, nightlife, or culture</li>
            <li>You're based in India or have an India connection</li>
            <li>You can commit to a long-form conversation</li>
          </ul>
          <p class="vf-apply-note">All submissions are reviewed personally. If there's a fit, you'll hear back within a week.</p>
        </div>

        <div class="vf-apply-right">
          <form class="vf-form guest-form" data-sb-table="podcast_applications">
            <input type="hidden" name="_next" value="https://djvicofficial.com/thanks/?from=vicfix" />
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
            <div class="vf-form-row">
              <div class="vf-field">
                <label for="guest-name">Full name <span class="vf-req">*</span></label>
                <input type="text" id="guest-name" name="name" placeholder="Your name" required />
              </div>
              <div class="vf-field">
                <label for="guest-email">Email <span class="vf-req">*</span></label>
                <input type="email" id="guest-email" name="email" placeholder="your@email.com" required />
              </div>
            </div>
            <div class="vf-form-row">
              <div class="vf-field">
                <label for="guest-phone">Phone / WhatsApp</label>
                <input type="tel" id="guest-phone" name="phone" placeholder="+91 98765 43210" />
              </div>
              <div class="vf-field">
                <label for="guest-instagram">Instagram</label>
                <input type="text" id="guest-instagram" name="instagram" placeholder="@yourhandle" />
              </div>
            </div>
            <div class="vf-field">
              <label for="guest-role">What do you do? <span class="vf-req">*</span></label>
              <select id="guest-role" name="role" required>
                <option value="" disabled selected>Select your background</option>
                <option value="DJ">DJ / Producer</option>
                <option value="Artist">Artist / Musician</option>
                <option value="Venue">Venue owner / operator</option>
                <option value="Promoter">Promoter / event organiser</option>
                <option value="Bartender">Bartender / mixologist</option>
                <option value="Brand">Brand / creative director</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="vf-field">
              <label for="guest-story">Your story <span class="vf-req">*</span></label>
              <textarea id="guest-story" name="story" rows="4" placeholder="Who you are, what you've been part of, and why your story belongs on the show." required></textarea>
            </div>
            <button type="submit" class="vf-btn vf-btn--gold vf-form-submit">Send my story &rarr;</button>
          </form>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script>
  // WhatsApp ping to VIC when a guest application is submitted (Supabase handles
  // the actual insert via the data-sb-table hook).
  const gForm = document.querySelector('form.guest-form[data-sb-table]');
  if (gForm) {
    gForm.addEventListener('submit', function () {
      const name = document.getElementById('guest-name')?.value || '';
      const role = document.getElementById('guest-role')?.value || '';
      const msg = encodeURIComponent(`🎙️ New VIC Fix guest application\n\nName: ${name}\nRole: ${role}\n\n(Full details in the admin.)`);
      setTimeout(() => { window.open(`https://wa.me/919611711677?text=${msg}`, '_blank'); }, 1000);
    });
  }
</script>

<style>
  .vfx-page { color: #fff; }
  .vfx-page a { text-decoration: none; }
  .vf-inner, .vf-hero-grid, .vf-start-inner, .vf-about-grid, .vf-apply-grid { max-width: 1180px; margin: 0 auto; }

  /* shared section header */
  .vf-head { margin-bottom: 4px; }
  .vf-rule { display: block; width: 40px; height: 2px; background: var(--gold); margin-bottom: 16px; }
  .vf-eyebrow { display: block; font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 500; letter-spacing: .26em; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
  .vf-h2 { font-family: 'Bebas Neue', sans-serif; font-weight: 400; font-size: clamp(28px, 4vw, 40px); letter-spacing: .04em; line-height: 1; color: #fff; margin: 0; }

  .vf-badge-solid { font-family: 'DM Sans', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #050a08; background: var(--gold); border-radius: 2px; padding: 3px 8px; }
  .vf-badge-out { font-family: 'DM Sans', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); border: 1px solid rgba(201,168,76,.4); border-radius: 2px; padding: 3px 7px; }

  .vf-btn { display: inline-flex; align-items: center; justify-content: center; font-family: 'DM Sans', sans-serif; font-size: 12.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 12px 20px; border-radius: 2px; transition: background .2s, border-color .2s, color .2s; cursor: pointer; }
  .vf-btn--gold { background: var(--gold); color: #050a08; border: 1px solid var(--gold); }
  .vf-btn--gold:hover { background: var(--gold-light); border-color: var(--gold-light); }
  .vf-btn--ghost { background: transparent; color: rgba(255,255,255,.8); border: 1px solid #2a2a2a; }
  .vf-btn--ghost:hover { border-color: var(--gold); color: var(--gold); }

  /* ── Hero ── */
  .vf-hero { padding: 6px 0 0; }
  .vf-hero-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 48px 56px; align-items: start; padding: 56px 28px 44px; }
  .vf-h1 { font-family: 'Space Grotesk', sans-serif; font-weight: 300; font-size: clamp(42px, 6.4vw, 76px); line-height: 1.02; letter-spacing: -.025em; color: #fff; margin: 0 0 12px; }
  .vf-tagline { font-family: 'Bebas Neue', sans-serif; font-size: clamp(19px, 2.4vw, 26px); letter-spacing: .06em; color: var(--gold); margin: 0 0 18px; }
  .vf-body { font-family: 'Space Grotesk', sans-serif; font-size: 15.5px; line-height: 1.75; color: rgba(255,255,255,.66); max-width: 46ch; margin: 0 0 24px; }
  .vf-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 30px; }
  .vf-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(201,168,76,.14); border: 1px solid rgba(201,168,76,.14); max-width: 420px; }
  .vf-stat { background: #0b0b0b; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
  .vf-stat strong { font-family: 'Bebas Neue', sans-serif; font-weight: 400; font-size: 34px; line-height: 1; color: #fff; }
  .vf-stat span { font-family: 'DM Sans', sans-serif; font-size: 10.5px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.5); }

  .vf-latest { display: block; border: 1px solid #1e1e1e; background: #0c0c0c; transition: border-color .2s; }
  .vf-latest:hover { border-color: rgba(201,168,76,.45); }
  .vf-latest-thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; }
  .vf-latest-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(.9); }
  .vf-latest-thumb::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(6,6,6,.97) 4%, rgba(6,6,6,.1) 58%, transparent); }
  .vf-latest-badges { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; z-index: 2; }
  .vf-latest-over { position: absolute; left: 16px; right: 16px; bottom: 14px; z-index: 2; display: flex; flex-direction: column; gap: 2px; }
  .vf-latest-name { font-family: 'Bebas Neue', sans-serif; font-size: clamp(24px, 3vw, 34px); letter-spacing: .03em; color: #fff; line-height: 1; text-shadow: 0 1px 4px rgba(0,0,0,.8); }
  .vf-latest-role { font-size: 12.5px; color: var(--gold); }
  .vf-latest-hook { font-family: 'Space Grotesk', sans-serif; font-size: 13.5px; line-height: 1.6; color: rgba(255,255,255,.62); padding: 16px 16px 0; margin: 0; }
  .vf-latest-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; margin-top: 12px; border-top: 1px solid #1a1a1a; }
  .vf-latest-read { font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); }
  .vf-latest-date { font-family: 'DM Mono', monospace; font-size: 11px; color: rgba(255,255,255,.38); }

  .vf-nextup { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 12px; padding: 12px 16px; background: rgba(201,168,76,.07); border: 1px solid rgba(201,168,76,.22); }
  .vf-nextup-chip { font-family: 'DM Sans', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #050a08; background: var(--gold); padding: 3px 8px; border-radius: 2px; }
  .vf-nextup-text { font-family: 'Space Grotesk', sans-serif; font-size: 13px; color: rgba(255,255,255,.78); }

  /* ── Start with these three ── */
  .vf-start { border-top: 1px solid #141414; background: rgba(0,0,0,.28); }
  .vf-start-inner { padding: 48px 28px 52px; }
  .vf-start-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 26px; }
  .vf-start-note { font-family: 'Space Grotesk', sans-serif; font-size: 13.5px; line-height: 1.6; color: rgba(255,255,255,.5); max-width: 34ch; text-align: right; margin: 0; }
  .vf-start-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1px; background: #1a1a1a; border: 1px solid #1a1a1a; }
  .vf-scard { display: flex; flex-direction: column; background: #0e0e0e; transition: background .2s; }
  .vf-scard:hover { background: #151515; }
  .vf-scard-thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; }
  .vf-scard-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(.82); }
  .vf-scard-code { position: absolute; top: 10px; left: 10px; }
  .vf-scard-body { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px 20px; }
  .vf-scard-strand { font-family: 'DM Sans', sans-serif; font-size: 10.5px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.42); }
  .vf-scard-name { font-family: 'Bebas Neue', sans-serif; font-size: 25px; letter-spacing: .03em; color: #fff; }
  .vf-scard-role { font-size: 12.5px; color: var(--gold); }
  .vf-scard-copy { font-family: 'Space Grotesk', sans-serif; font-size: 13.5px; line-height: 1.6; color: rgba(255,255,255,.6); }

  /* ── About ── */
  .vf-about { border-top: 1px solid #141414; background: rgba(0,0,0,.28); }
  .vf-about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; padding: 52px 28px; }
  .vf-about-p { font-family: 'Space Grotesk', sans-serif; font-size: 14.5px; line-height: 1.75; color: rgba(255,255,255,.64); max-width: 52ch; margin: 18px 0 0; }
  .vf-about-p a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  .vf-about-p a:hover { color: var(--gold-light); }
  .vf-platforms { display: grid; gap: 1px; background: #1a1a1a; border: 1px solid #1a1a1a; margin-bottom: 26px; }
  .vf-plat { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 15px 18px; background: #0e0e0e; transition: background .2s; }
  .vf-plat:hover { background: #151515; }
  .vf-plat-name { font-family: 'Bebas Neue', sans-serif; font-size: 19px; letter-spacing: .04em; color: #fff; }
  .vf-plat-handle { font-family: 'DM Mono', monospace; font-size: 11.5px; color: var(--gold); }
  .vf-quote { border-left: 2px solid var(--gold); padding: 4px 0 4px 18px; margin: 0; }
  .vf-quote p { font-family: 'Space Grotesk', sans-serif; font-size: 14.5px; line-height: 1.7; color: rgba(255,255,255,.8); margin: 0 0 10px; }
  .vf-quote cite { font-family: 'DM Sans', sans-serif; font-style: normal; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: rgba(201,168,76,.8); }

  /* ── Apply ── */
  .vf-apply { border-top: 1px solid rgba(201,168,76,.14); }
  .vf-apply-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 48px; padding: 52px 28px 68px; }
  .vf-apply-body { font-family: 'Space Grotesk', sans-serif; font-size: 14.5px; line-height: 1.75; color: rgba(255,255,255,.66); max-width: 44ch; margin: 18px 0 20px; }
  .vf-criteria { list-style: none; padding: 0; margin: 0 0 20px; display: flex; flex-direction: column; gap: 9px; }
  .vf-criteria li { font-family: 'Space Grotesk', sans-serif; font-size: 13.5px; color: rgba(255,255,255,.6); padding-left: 18px; position: relative; }
  .vf-criteria li::before { content: '—'; position: absolute; left: 0; color: var(--gold); }
  .vf-apply-note { font-family: 'Space Grotesk', sans-serif; font-size: 12.5px; line-height: 1.6; color: rgba(255,255,255,.38); margin: 0; }

  .vf-form { background: #0b0b0b; border: 1px solid #1e1e1e; padding: 26px; display: flex; flex-direction: column; gap: 16px; }
