---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Today (Asia/Kolkata) as YYYY-MM-DD — used to keep only genuinely upcoming
// shows in the "Upcoming Shows" list. A past event listed as "upcoming" reads
// as a dead calendar, so it must be filtered out at build time.
const todayISO = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });

const eventsData = allEvents.map(e => ({
  slug: e.id,
  title: e.data.title,
  date: e.data.date,
  time: e.data.time,
  venue: e.data.venue,
  address: e.data.address || '',
  city: e.data.city,
  isPrivate: e.data.isPrivate || false,
  guestListAvailable: e.data.guestListAvailable || false,
  creativeImage: e.data.creativeImage || '',
  dresscode: e.data.dresscode || '',
  genre: e.data.genre || [],
  hostedBy: e.data.hostedBy || '',
  videoSetBy: e.data.videoSetBy || '',
  description: e.data.description,
  tags: e.data.tags || [],
}));

// Nights VIC is playing that live on their own dedicated pages (Chamatkar), not
// the events collection — merged in so every booked date shows on one calendar.
// `href` points the modal + list link at that page instead of /events/<slug>/.
const CHAMATKAR = { time: '9:00 PM onwards', venue: 'Happy Brew', address: 'Koramangala', city: 'Bangalore',
  isPrivate: false, creativeImage: '', dresscode: '', genre: ['Bollywood', 'Audio-Visual'], hostedBy: '', videoSetBy: 'VIC', tags: [] };
const externalBookings = [
  { ...CHAMATKAR, slug: 'chamatkar-vol5', href: '/chamatkar/', title: 'Chamatkar Vol. 5', date: '2026-09-05', venue: 'Happy Brew Cocktail Club', guestListAvailable: true,  description: 'Bollywood × global, live audio-visual set.', tags: ['Bangalore', 'Bollywood'] },
  { ...CHAMATKAR, slug: 'chamatkar-v4',   href: '/chamatkar/', title: 'Chamatkar Vol. 4', date: '2026-08-22', guestListAvailable: false, description: 'The 90s / 2000s Edition.' },
  { ...CHAMATKAR, slug: 'chamatkar-v3',   href: '/chamatkar/', title: 'Chamatkar Vol. 3', date: '2026-08-01', guestListAvailable: false, description: 'The Mashup Edition.' },
  { ...CHAMATKAR, slug: 'chamatkar-v2',   href: '/chamatkar/', title: 'Chamatkar Vol. 2', date: '2026-07-11', guestListAvailable: false, description: '90s & 2000s edition.' },
  { ...CHAMATKAR, slug: 'chamatkar-v1',   href: '/chamatkar/', title: 'Chamatkar Vol. 1', date: '2026-06-13', guestListAvailable: false, description: 'The one that started it.' },
];
const calendarData = [...eventsData, ...externalBookings];

// Public anon key — safe to inline. Used only to pull live blocked/booked dates
// (accepted gigs) from a DATES-ONLY function; no client details ever leave the DB.
const SUPABASE_URL = 'https://jftnhuutttmccmqnnybf.supabase.co';
const SUPABASE_KEY = 'sb_publishable_ysWygc3QGKbfsUd0f7Evzw__98TEoo9';
---

<Layout
  title="Events — DJ VIC Live in Bangalore"
  description="Catch DJ VIC live — view upcoming events, club nights and sets in Bangalore. Click a date to see event details and join the guest list."
  canonical="https://djvicofficial.com/events/"
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "EventSeries",
      "name": "DJ VIC Live Events — Bangalore",
      "url": "https://djvicofficial.com/events/",
      "organizer": { "@id": "https://djvicofficial.com/#person" }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",   "item": "https://djvicofficial.com/" },
        { "@type": "ListItem", "position": 2, "name": "Events", "item": "https://djvicofficial.com/events/" }
      ]
    }
  ]}
>
  <Nav />

  <main id="main-content">

    <!-- ── Hero ─────────────────────────────────────── -->
    <section id="events-hero">
      <div class="hero-inner">
        <span class="hero-label">Dates &amp; Availability</span>
        <h1>Events</h1>
        <p class="hero-sub"><b style="color:#39b56a">Green</b> means I'm open · <b style="color:#e0574a">red</b> means booked.<br/>Tap a free date to enquire, or a booked date to see what's on.</p>
      </div>
    </section>

    <!-- ── Calendar ──────────────────────────────────── -->
    <section id="calendar-section">
      <div class="cal-container" id="cal-container">

        <!-- Month nav -->
        <div class="cal-header">
          <button class="cal-arrow" id="cal-prev" aria-label="Previous month">&#8592;</button>
          <div class="cal-header-center">
            <span class="cal-month-name" id="cal-month-name"></span>
            <select class="cal-year-select" id="year-select" aria-label="Select year">
              <option value="2025">2025</option>
              <option value="2026">2026</option>
              <option value="2027">2027</option>
            </select>
          </div>
          <button class="cal-arrow" id="cal-next" aria-label="Next month">&#8594;</button>
        </div>

        <!-- Day labels -->
        <div class="cal-day-labels">
          <span>Sun</span><span>Mon</span><span>Tue</span>
          <span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
        </div>

        <!-- Date grid -->
        <div class="cal-grid" id="cal-grid"></div>

      </div>

      <div class="cal-legend">
        <span class="leg-item"><span class="leg-dot leg-dot--free"></span> Available</span>
        <span class="leg-item"><span class="leg-dot leg-dot--booked"></span> Booked</span>
      </div>

      <p class="cal-no-events" id="cal-no-events" style="display:none">
        No events this month — check back soon.
      </p>
    </section>

    <!-- ── Upcoming Events (static list for search-engine discoverability) ── -->
    {calendarData.filter(e => !e.isPrivate && e.date >= todayISO).length > 0 && (
      <section id="upcoming-events-list">
        <div class="upcoming-inner">
          <div class="uel-label">Upcoming Shows</div>
          <ul class="events-list" role="list">
            {calendarData
              .filter(e => !e.isPrivate && e.date >= todayISO)
              .sort((a, b) => a.date.localeCompare(b.date))
              .map(e => (
                <li>
                  <a href={`${base}${e.href || `/events/${e.slug}/`}`} class="event-list-item">
                    <span class="eli-date">{new Date(e.date + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                    <span class="eli-title">{e.title}</span>
                    <span class="eli-venue">{e.venue} &middot; {e.city}</span>
                    {e.guestListAvailable && <span class="eli-badge">Guest List Open</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )}

  </main>

  <!-- ── Modal ─────────────────────────────────────── -->
  <div class="modal-overlay" id="event-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box">
      <button class="modal-close" id="modal-close" aria-label="Close">&times;</button>

      <div id="modal-img-wrap">
        <img src="" alt="" id="modal-img" class="modal-img" width="800" height="800" />
      </div>

      <div class="modal-content">

        <!-- Private state -->
        <div id="modal-private" style="display:none">
          <span class="private-badge">Private Event</span>
          <p class="private-text">This is a private booking — not open to the public.</p>
        </div>

        <!-- Public state -->
        <div id="modal-public">
          <p class="modal-datetime" id="modal-datetime"></p>
          <h2 class="modal-title" id="modal-title"></h2>

          <div id="modal-venue-block">
            <p class="modal-venue" id="modal-venue"></p>
            <p class="modal-address" id="modal-address"></p>
          </div>

          <div id="modal-genre-wrap">
            <span class="field-label" style="display:block;margin-bottom:6px">Genres</span>
            <div class="modal-tags" id="modal-genre"></div>
          </div>

          <div class="modal-field" id="modal-dresscode-wrap">
            <span class="field-label">Dress Code</span>
            <span class="field-value" id="modal-dresscode"></span>
          </div>

          <div class="modal-field" id="modal-lineup-wrap">
            <span class="field-label">Line-up</span>
            <span class="field-value" id="modal-lineup"></span>
          </div>
        </div>

        <div class="modal-divider" id="modal-divider"></div>

        <div id="modal-cta-wrap">
          <a href="#" id="modal-cta" class="modal-cta-btn">Join the Guest List &rarr;</a>
        </div>

      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script define:vars={{ eventsData: calendarData, base, SUPABASE_URL, SUPABASE_KEY }}>
  const MONTHS = ['January','February','March','April','May','June',
                  'July','August','September','October','November','December'];
  const DAYS_LONG = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const MONTHS_LONG = ['January','February','March','April','May','June',
                       'July','August','September','October','November','December'];

  // Event map: 'YYYY-MM-DD' -> event
  const eventMap = {};
  for (const ev of eventsData) eventMap[ev.date] = ev;

  const today = new Date();
  let currentYear = today.getFullYear();
  let currentMonth = today.getMonth();

  // Open on the month of the nearest upcoming booking, so the calendar never
  // lands on an empty grid (which reads as "broken").
  const _p = (n) => String(n).padStart(2, '0');
  const _todayStr = `${today.getFullYear()}-${_p(today.getMonth()+1)}-${_p(today.getDate())}`;
  const _next = eventsData.map(e => e.date).filter(d => d >= _todayStr).sort()[0];
  if (_next) { const [_y, _m] = _next.split('-').map(Number); currentYear = _y; currentMonth = _m - 1; }

  const yearSelect = document.getElementById('year-select');
  yearSelect.value = currentYear;

  function pad(n) { return String(n).padStart(2, '0'); }

  function renderCalendar(year, month) {
    document.getElementById('cal-month-name').textContent = `${MONTHS[month]}`;
    yearSelect.value = year;

    const firstDay  = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const todayStr  = `${today.getFullYear()}-${pad(today.getMonth()+1)}-${pad(today.getDate())}`;

    const grid = document.getElementById('cal-grid');

    // Trigger slide-in animation on re-render
    grid.style.animation = 'none';
    void grid.offsetWidth;
    grid.style.animation = '';

    grid.innerHTML = '';
    let hasBooking = false;
    let hasAvailable = false;

    // Empty leading cells
    for (let i = 0; i < firstDay; i++) {
      const empty = document.createElement('div');
      empty.className = 'cal-cell cal-cell--empty';
      grid.appendChild(empty);
    }

    // Date cells — an availability view: green = open, red = booked.
    for (let d = 1; d <= daysInMonth; d++) {
      const dateStr   = `${year}-${pad(month+1)}-${pad(d)}`;
      const event     = eventMap[dateStr];
      const isToday   = dateStr === todayStr;
      const isPast    = dateStr < todayStr;
      const available = !event && !isPast;   // future date with nothing booked

      const cell = document.createElement('div');
      const cls  = ['cal-cell'];
      if (isToday) cls.push('cal-cell--today');
      if (isPast)  cls.push('cal-cell--past');
      if (event && !event.isPrivate) cls.push('cal-cell--event');
      if (event &&  event.isPrivate) cls.push('cal-cell--private');
      if (available) cls.push('cal-cell--available');
      cell.className = cls.join(' ');

      const num = document.createElement('span');
      num.className = 'cal-num';
      num.textContent = d;
      cell.appendChild(num);

      if (event) {
        // Booked — red marker. Public bookings open details; private just block the date.
        hasBooking = true;
        const dot = document.createElement('span');
        dot.className = event.isPrivate ? 'cal-dot cal-dot--booked cal-dot--dim' : 'cal-dot cal-dot--booked';
        cell.appendChild(dot);

        const label = document.createElement('span');
        label.className = 'cal-label';
        label.textContent = event.isPrivate ? 'Booked' : event.title;
        cell.appendChild(label);

        if (!event.isPrivate) {
          cell.setAttribute('tabindex', '0');
          cell.setAttribute('role', 'button');
          cell.setAttribute('aria-label', `${event.title} — ${dateStr}. Booked. Press Enter for details.`);
          cell.addEventListener('click', () => openModal(event));
          cell.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(event); }
          });
        }
      } else if (available) {
        // Open — green marker, taps through to the booking enquiry for that date.
        hasAvailable = true;
        const dot = document.createElement('span');
        dot.className = 'cal-dot cal-dot--free';
        cell.appendChild(dot);

        const go = () => { window.location.href = `${base}/book/?date=${dateStr}`; };
        cell.setAttribute('tabindex', '0');
        cell.setAttribute('role', 'button');
        cell.setAttribute('aria-label', `${dateStr} — available. Press Enter to enquire about this date.`);
        cell.addEventListener('click', go);
        cell.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
        });
      }

      grid.appendChild(cell);
    }

    const msg = document.getElementById('cal-no-events');
    if (hasBooking) {
      msg.style.display = 'none';
    } else if (hasAvailable) {
      msg.textContent = 'Fully open this month — every date available.';
      msg.style.display = 'block';
    } else {
      msg.style.display = 'none';
    }
  }

  function openModal(event) {
    const modal = document.getElementById('event-modal');

    // Image
    const imgWrap = document.getElementById('modal-img-wrap');
    const img     = document.getElementById('modal-img');
    if (event.creativeImage) {
      img.src = event.creativeImage;
      img.alt = event.title;
      imgWrap.style.display = 'block';
    } else {
      imgWrap.style.display = 'none';
    }

    if (event.isPrivate) {
      document.getElementById('modal-private').style.display = 'block';
      document.getElementById('modal-public').style.display  = 'none';
      document.getElementById('modal-cta-wrap').style.display = 'none';
      document.getElementById('modal-divider').style.display  = 'none';
      document.getElementById('modal-title').textContent = 'Private Event';
    } else {
      document.getElementById('modal-private').style.display = 'none';
      document.getElementById('modal-public').style.display  = 'block';
      document.getElementById('modal-title').textContent = event.title;

      // Date + time line  e.g. "SATURDAY, 25 APRIL 2026  ·  9:00 PM ONWARDS"
      const d = new Date(event.date + 'T00:00:00');
      const dayName  = DAYS_LONG[d.getDay()].toUpperCase();
      const monthName = MONTHS_LONG[d.getMonth()].toUpperCase();
      document.getElementById('modal-datetime').textContent =
        `${dayName}, ${d.getDate()} ${monthName} ${d.getFullYear()}  ·  ${event.time.toUpperCase()}`;

      // Venue
      document.getElementById('modal-venue').textContent = event.venue;
      const addrEl = document.getElementById('modal-address');
      addrEl.textContent  = event.address;
      addrEl.style.display = event.address ? 'block' : 'none';
      document.getElementById('modal-venue-block').style.display = 'block';

      // Genre tags
      const genreWrap    = document.getElementById('modal-genre');
      const genreSection = document.getElementById('modal-genre-wrap');
      genreWrap.innerHTML = '';
      if (event.genre && event.genre.length) {
        event.genre.forEach(g => {
          const span = document.createElement('span');
          span.className   = 'modal-tag';
          span.textContent = g;
          genreWrap.appendChild(span);
        });
        genreSection.style.display = 'block';
        genreWrap.style.display    = 'flex';
      } else {
        genreSection.style.display = 'none';
      }

      // Dress code
      const dcWrap = document.getElementById('modal-dresscode-wrap');
      if (event.dresscode) {
        document.getElementById('modal-dresscode').textContent = event.dresscode;
        dcWrap.style.display = 'flex';
      } else {
        dcWrap.style.display = 'none';
      }

      // Line-up
      const luWrap  = document.getElementById('modal-lineup-wrap');
      const parts   = [];
      if (event.hostedBy)  parts.push(`Hosted by ${event.hostedBy}`);
      if (event.videoSetBy) parts.push(`Video Set by ${event.videoSetBy}`);
      if (parts.length) {
        document.getElementById('modal-lineup').textContent = parts.join('  ·  ');
        luWrap.style.display = 'flex';
      } else {
        luWrap.style.display = 'none';
      }

      // CTA
      const ctaWrap = document.getElementById('modal-cta-wrap');
      const divider = document.getElementById('modal-divider');
      if (event.guestListAvailable) {
        document.getElementById('modal-cta').href = `${base}${event.href || `/events/${event.slug}/`}`;
        ctaWrap.style.display = 'block';
        divider.style.display = 'block';
      } else {
        ctaWrap.style.display = 'none';
        divider.style.display = 'none';
      }
    }

    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    document.getElementById('modal-close').focus();
  }

  function closeModal() {
    document.getElementById('event-modal').classList.remove('open');
    document.body.style.overflow = '';
  }

  document.getElementById('cal-prev').addEventListener('click', () => {
    currentMonth--;
    if (currentMonth < 0) { currentMonth = 11; currentYear--; }
    renderCalendar(currentYear, currentMonth);
  });

  document.getElementById('cal-next').addEventListener('click', () => {
    currentMonth++;
    if (currentMonth > 11) { currentMonth = 0; currentYear++; }
    renderCalendar(currentYear, currentMonth);
  });

  yearSelect.addEventListener('change', (e) => {
    currentYear = parseInt(e.target.value);
    renderCalendar(currentYear, currentMonth);
  });

  document.getElementById('modal-close').addEventListener('click', closeModal);
  document.getElementById('event-modal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('event-modal')) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  renderCalendar(currentYear, currentMonth);

  // Live availability: pull VIC's accepted-gig dates (dates ONLY — no client
  // detail leaves the DB) and mark any not already shown as booked. Fails
  // silently if the function isn't installed yet, so the calendar always renders.
  fetch(`${SUPABASE_URL}/rest/v1/rpc/vic_blocked_dates`, {
    method: 'POST',
    headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}`, 'Content-Type': 'application/json' },
    body: '{}'
  })
    .then(r => r.ok ? r.json() : [])
    .then(rows => {
      let added = false;
      (rows || []).forEach(row => {
        const d = typeof row === 'string' ? row : (row && row.d);
        if (d && !eventMap[d]) { eventMap[d] = { date: d, title: 'Booked', isPrivate: true }; added = true; }
      });
      if (added) renderCalendar(currentYear, currentMonth);
    })
    .catch(() => {});
</script>

<style is:global>
  /* ── Hero ─────────────────────────────────────────── */
  #events-hero {
    padding: 7rem 2rem 3.5rem;
    text-align: center;
  }
  #events-hero .hero-inner {
    max-width: 640px;
    margin-inline: auto;
  }
  #events-hero .hero-label {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a84c;
    margin-bottom: 1.25rem;
  }
  #events-hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(64px, 12vw, 96px);
    color: #e0dccf;
    letter-spacing: 0.04em;
    line-height: 1;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }
  #events-hero .hero-sub {
    font-size: 15px;
    color: #888880;
    line-height: 1.7;
    max-width: 480px;
    margin-inline: auto;
  }

  /* ── Calendar section ─────────────────────────────── */
  #calendar-section {
    padding: 0 1.5rem 5rem;
  }
  #calendar-section .cal-container {
    max-width: 860px;
    margin-inline: auto;
    background: #111111;
    border: 1px solid #1e1e1e;
    border-radius: 8px;
    padding: 40px;
    animation: fadeIn 0.3s ease;
  }

  /* ── Calendar header ──────────────────────────────── */
  #calendar-section .cal-header {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  #calendar-section .cal-arrow {
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid #1e1e1e;
    color: #c9a84c;
    font-size: 18px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s, background 0.15s;
    flex-shrink: 0;
  }
  #calendar-section .cal-arrow:hover {
    border-color: #c9a84c;
    background: #1a1500;
  }
  #calendar-section .cal-header-center {
    text-align: center;
  }
  #calendar-section .cal-month-name {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 48px;
    letter-spacing: 0.05em;
    color: #e0dccf;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  #calendar-section .cal-year-select {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: #c9a84c;
    background: #0d0d0d;
    border: 1px solid #2a2a2a;
    padding: 4px 12px;
    border-radius: 4px;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    text-align: center;
    text-align-last: center;
  }

  /* ── Day labels ───────────────────────────────────── */
  #calendar-section .cal-day-labels {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    border-bottom: 1px solid #1e1e1e;
    margin-bottom: 0;
  }
  #calendar-section .cal-day-labels span {
    text-align: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #555550;
    padding: 12px 0;
  }

  /* ── Grid ─────────────────────────────────────────── */
  #cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    animation: slideIn 0.2s ease;
  }

  /* ── Cells — all JS-generated, must be global ──────── */
  #cal-grid .cal-cell {
    min-height: 80px;
    padding: 10px 8px;
    border: 1px solid #0f0f0f;
    position: relative;
    cursor: default;
    vertical-align: top;
    transition: background 0.15s;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  #cal-grid .cal-cell--empty {
    background: #0a0a0a;
    opacity: 0.4;
  }
  #cal-grid .cal-cell--today {
    border-color: #2a2000;
  }
  #cal-grid .cal-cell--event {
    cursor: pointer;
    border-color: #2a2000;
  }
  #cal-grid .cal-cell--event:hover {
    background: #1a1500;
