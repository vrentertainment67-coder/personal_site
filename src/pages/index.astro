---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroVideo from '../components/HeroVideo.astro';
import TestimonialsStrip from '../components/TestimonialsStrip.jsx';
import WeekendPopup from '../components/WeekendPopup.astro';
import { getCollection } from 'astro:content';
import { getEpisodes } from '../lib/vicfix.js';
import { siteConfig as cfg } from '../config/siteConfig';

const _todayISO = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });

// This-weekend promo — nights shown in the load popup; a night auto-hides once its date passes.
const weekend = [
  { day: 'Friday',   dateLabel: '4 Sep', date: '2026-09-04', name: 'Filmy Fridays',    venue: 'No Limmits', tag: 'Bollywood · audio-visual',    href: '/filmy-fridays/', theme: 'ff', slug: 'filmy-fridays-sep-2026' },
  { day: 'Saturday', dateLabel: '12 Sep', date: '2026-09-12', name: 'Chamatkar Vol. 5', venue: 'Happy Brew', tag: 'Bollywood × global · live AV', href: '/chamatkar/',     theme: 'ck', slug: 'chamatkar-vol5' },
].filter(e => e.date >= _todayISO);

// Build-time: reviews for AggregateRating rich snippets (mirrors the homepage strip).
const FALLBACK_REVIEWS = [
  { author: 'Kruthi S.', quote: 'VIC made our wedding night truly unforgettable. The transitions were seamless, the energy never dropped, and the audio-visual element left our guests speechless.', rating: 5 },
  { author: 'Rashmi J.', quote: 'We booked VIC for our annual brand event and he read the room perfectly — from the opening set to the close, it was exactly the tone we needed.', rating: 5 },
  { author: 'Aryaman & Prerna', quote: 'We wanted our reception to feel cinematic, not just loud. VIC understood exactly what we meant — the music and visuals together were something else.', rating: 5 },
];
let reviewExtra = {};
try {
  const rr = await fetch(`${import.meta.env.PUBLIC_SUPABASE_URL}/rest/v1/rpc/public_reviews`, {
    method: 'POST',
    headers: { apikey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY, Authorization: `Bearer ${import.meta.env.PUBLIC_SUPABASE_ANON_KEY}`, 'Content-Type': 'application/json' },
    body: '{"p_category":"home"}',
  });
  const db = rr.ok ? await rr.json() : [];
  const reviews = (Array.isArray(db) && db.length ? db : FALLBACK_REVIEWS).map((r) => ({ author: r.author, quote: r.quote, rating: r.rating || 5 })).filter((r) => r.author && r.quote);
  if (reviews.length) {
    const avg = reviews.reduce((s, r) => s + r.rating, 0) / reviews.length;
    reviewExtra = {
      aggregateRating: { '@type': 'AggregateRating', ratingValue: avg.toFixed(1), reviewCount: reviews.length, bestRating: 5, worstRating: 1 },
      review: reviews.slice(0, 6).map((r) => ({ '@type': 'Review', author: { '@type': 'Person', name: r.author }, reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5, worstRating: 1 }, reviewBody: r.quote })),
    };
  }
} catch (e) { /* no rich snippets if the fetch fails */ }

// Latest 3 remixes (with a video). Download-only tracks live on /remixes/.
const latestRemixes = (await getCollection('remixes'))
  .filter((r) => r.data.youtubeId)
  .sort((a, b) => new Date(b.data.releaseDate).getTime() - new Date(a.data.releaseDate).getTime())
  .slice(0, 3);
const remixTypeLabel = { mashup: 'Mashup', remix: 'Remix', edit: 'Edit', rework: 'Rework' };

// Podcast — derived, not hardcoded. Latest 2 published episodes + the next upcoming one.
const eps = await getEpisodes();
const publishedEps = eps.filter((e) => !e.date || e.date <= _todayISO);
const latestEps = publishedEps.slice(0, 2);
const upcomingEp = eps.filter((e) => e.date && e.date > _todayISO).sort((a, b) => a.date.localeCompare(b.date))[0] || null;
const epCode = (e) => `S${e.s} · E${e.n}`;

// Intent routing band.
const routes = [
  { eyebrow: 'Planning a wedding?',       title: 'Weddings & Sangeet', copy: 'Sangeet, reception, the last dance — one DJ across every function.', href: '/weddings/',  cta: 'Weddings',  accent: true },
  { eyebrow: 'Corporate or brand event?', title: 'Corporate',          copy: 'Conferences, launches and annual days, read room by room.',          href: '/corporate/', cta: 'Corporate', accent: false },
  { eyebrow: 'Booking a night?',          title: 'Club & Nightlife',   copy: 'Open-format audio-visual sets built for the dance floor.',            href: '/nightlife/', cta: 'Nightlife', accent: false },
];

// Work — two majors (stacked image over text). Real wedding/corporate photography
// is pending (see handoff); the slots stay admin-replaceable via Page Images.
const primaryServices = [
  { name: 'Weddings & Sangeet', href: '/weddings/', badge: 'Most booked', img: '/images/home/work-weddings-placeholder.jpg', slot: 'home.weddings-bg',
    copy: 'From the sangeet night to the last dance — curated music and visuals for every moment of your celebration.', note: `Pan-India & international · ${cfg.weddings} weddings`, cta: 'Explore weddings' },
  { name: 'Corporate Events', href: '/corporate/', badge: '', img: '/images/home/work-corporate-placeholder.jpg', slot: 'home.corporate-bg',
    copy: 'Conferences, product launches, annual days — delivered with precision and the right energy for every room.', note: 'Apple · JPMorgan · KPMG · PepsiCo · Ritz-Carlton', cta: 'Explore corporate' },
];
const tiles = [
  { name: 'Club & Nightlife',       href: '/nightlife/',        desc: 'Open-format sets built for the dance floor.' },
  { name: 'Private Events',         href: '/private-events/',   desc: 'Birthdays, anniversaries, brand parties.' },
  { name: 'Festivals & Live Shows', href: '/festivals/',        desc: 'Big-room, open-air, full production.' },
  { name: 'Audio-Visual DJ',        href: '/audio-visual-dj/',  desc: 'Original music synced to custom visuals.' },
  { name: 'Private Sessions',       href: '/private-sessions/', desc: 'One-on-one craft sessions, by enquiry.' },
  { name: 'All Services',           href: '/book/',             desc: 'Every format, one booking flow.' },
];

// Pre-whitened PNGs (rendered from the client SVGs) — some source SVGs lack a
// viewBox and won't scale inside an <img>, so we rasterize to a uniform silhouette.
const trustLogos = [
  ['apple', 'Apple'], ['jpmorgan', 'JPMorgan'], ['kpmg', 'KPMG'], ['ritz-carlton', 'The Ritz-Carlton'], ['pepsico', 'PepsiCo'],
  ['decathlon', 'Decathlon'], ['hdfc', 'HDFC'], ['walmart', 'Walmart'], ['sap', 'SAP'], ['infosys', 'Infosys'],
];

const eventTypes = [
  ['wedding', 'Wedding'], ['sangeet', 'Sangeet night'], ['corporate', 'Corporate event / brand launch'],
  ['nightlife', 'Club night'], ['private', 'Private party'], ['festival', 'Festival / live show'], ['other', 'Something else'],
];
---

<Layout
  title="DJ VIC — Wedding, Corporate & Audio-Visual DJ · Bangalore"
  description={`Bangalore's premier wedding, corporate & audio-visual DJ. ${cfg.yearsActive}+ years, ${cfg.performances} shows across ${cfg.countries} countries — from luxury weddings to brand launches. Book DJ VIC.`}
  ogTitle="DJ VIC — International DJ · Audio-Visual Performances Across India & the World"
  ogDescription={`${cfg.yearsActive}+ years. ${cfg.countries} countries. ${cfg.performances} performances. DJ VIC delivers premium audio-visual DJ sets for weddings, corporate events, and live shows across India and internationally.`}
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://djvicofficial.com/#person",
        "name": "DJ VIC",
        "alternateName": ["Vikas Naik", "DJ Vic", "DJ VIC Official", "DJ VIC Bangalore"],
        "description": `International DJ, producer, and remixer based in Bangalore with ${cfg.yearsActive}+ years of experience across ${cfg.countries} countries. Universal Music partner.`,
        "url": "https://djvicofficial.com",
        "jobTitle": "DJ, Music Producer, Podcast Host",
        "sameAs": [
          "https://www.instagram.com/djvicofficial",
          "https://www.youtube.com/@thedjvicofficial",
          "https://www.facebook.com/djvicofficial",
          "https://audiomack.com/vrentertainment67"
        ]
      },
      {
        "@type": "LocalBusiness",
        "@id": "https://djvicofficial.com/#business",
        "name": "DJ VIC Official",
        "description": "Premium DJ services for weddings, corporate events, clubs and festivals in Bangalore.",
        "url": "https://djvicofficial.com",
        "telephone": "+919611711677",
        "email": "bookings@djvicofficial.com",
        "priceRange": "₹₹₹₹",
        "address": { "@type": "PostalAddress", "addressLocality": "Bangalore", "addressRegion": "Karnataka", "addressCountry": "IN" },
        "areaServed": ["Bangalore", "Mumbai", "Delhi", "Chennai", "India"],
        ...reviewExtra
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://djvicofficial.com/" }
        ]
      }
    ]
  }}
>
  <Nav />
  <main id="main-content" class="hm">

    <!-- 1 · Hero (unchanged component) -->
    <HeroVideo />

    <!-- 2 · Intent routing band -->
    <section class="hm-routes">
      <div class="hm-routes-grid">
        {routes.map((r, i) => (
          <a class={`hm-route${r.accent ? ' accent' : ''} fx-reveal`} data-fx-delay={(i % 3) + 1} href={r.href}>
            <span class={`hm-route-eyebrow${r.accent ? ' gold' : ''}`}>{r.eyebrow}</span>
            <span class="hm-route-title">{r.title}</span>
            <span class="hm-route-copy">{r.copy}</span>
            <span class="hm-route-cta">{r.cta} &rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 3 · Proof -->
    <section class="hm-block hm-proof">
      <div class="hm-inner">
        <p class="hm-lead">Active since {cfg.careerStart} — nearly two decades on stage, {cfg.countries} countries performed in, over {cfg.performances} nights of live sets.</p>
        <p class="hm-lead hm-peers">Shared the stage with <strong>Arijit Singh</strong>, <strong>Salim&ndash;Sulaiman</strong> &amp; <strong>Mika Singh</strong> — and opened for <strong>Bally Sagoo</strong>.</p>

        <div class="hm-stats">
          <div class="hm-stat"><strong>Est. {cfg.careerStart}</strong><span>In the industry</span></div>
          <div class="hm-stat"><strong>{cfg.countries}</strong><span>Countries</span></div>
          <div class="hm-stat"><strong>{cfg.performances}</strong><span>Nights performed</span></div>
          <div class="hm-stat"><strong>{cfg.weddings}</strong><span>Weddings</span></div>
        </div>

        <div class="hm-logos-wrap">
          <span class="hm-logos-label">Performed at events for teams at — and for {cfg.weddings} couples across India and abroad</span>
          <div class="hm-logos">
            {trustLogos.map(([file, name]) => (
              <img class="hm-logo" src={`/images/clients/white/${file}.png`} alt={name} loading="lazy" height="26" />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · Statement -->
    <section class="hm-statement">
      <div class="hm-inner">
        <h2 class="hm-statement-h">Not a DJ set.<br/>A performance.</h2>
        <p class="hm-statement-note">Signature format · since {cfg.careerStart}</p>
        <p class="hm-statement-p">Original music cut to custom visuals, mixed live and built around the room — the signature format since {cfg.careerStart}, and the reason the night stays with people.</p>
      </div>
    </section>

    <!-- 5 · Work -->
    <section class="hm-block hm-work">
      <div class="hm-inner">
        <div class="hm-head">
          <span class="hm-rule"></span>
          <span class="hm-eyebrow">The work</span>
          <h2 class="hm-h2">What VIC does</h2>
        </div>

        <div class="hm-majors">
          {primaryServices.map((s, i) => (
            <a class="hm-major fx-reveal" data-fx-delay={(i % 2) + 1} href={s.href}>
              <div class="hm-major-img">
                <img src={s.img} data-img-slot={s.slot} alt={`DJ VIC — ${s.name}`} loading="lazy" width="800" height="500" />
                {s.badge && <span class="hm-major-badge">{s.badge}</span>}
              </div>
              <div class="hm-major-body">
                <h3 class="hm-major-name">{s.name}</h3>
                <p class="hm-major-copy">{s.copy}</p>
                <span class="hm-major-note">{s.note}</span>
                <span class="hm-major-cta">{s.cta} &rarr;</span>
              </div>
            </a>
          ))}
        </div>

        <div class="hm-tiles">
          {tiles.map((t, i) => (
            <a class="hm-tile fx-reveal" data-fx-delay={(i % 3) + 1} href={t.href}>
              <span class="hm-tile-name">{t.name}</span>
              <span class="hm-tile-desc">{t.desc}</span>
              <span class="hm-tile-arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 6 · Testimonials (unchanged component) -->
    <section class="hm-block hm-testi">
      <div class="hm-inner">
        <div class="hm-head">
          <span class="hm-rule"></span>
          <span class="hm-eyebrow">What they say</span>
          <h2 class="hm-h2">Trusted by couples &amp; brands</h2>
        </div>
        <TestimonialsStrip client:visible category="home" />
      </div>
    </section>

    <!-- 7 · The Sound & The Stories -->
    <section class="hm-block hm-sound">
      <div class="hm-inner">
        <div class="hm-head">
          <span class="hm-rule"></span>
          <span class="hm-eyebrow">Off the stage</span>
          <h2 class="hm-h2">The Sound &amp; The Stories</h2>
        </div>
        <p class="hm-lead hm-sound-lead">Remixes built for the floor, and a podcast documenting the people who made India's nightlife.</p>

        <div class="hm-sound-cols">
          <div class="hm-sound-col">
            <div class="hm-subhead"><span class="hm-subhead-t">The Sound</span><a class="hm-subhead-link" href="/remixes/">Full catalogue &rarr;</a></div>
            {latestRemixes.map((r) => (
              <a class="hm-srow" href={`/remixes/${r.id}/`}>
                <div class="hm-srow-thumb"><img src={`https://img.youtube.com/vi/${r.data.youtubeId}/mqdefault.jpg`} alt={r.data.title} loading="lazy" width="116" height="65" /></div>
                <div class="hm-srow-text">
                  <span class="hm-srow-type">{remixTypeLabel[r.data.type] || 'Remix'}</span>
                  <span class="hm-srow-title">{r.data.title}</span>
                  {r.data.artists && r.data.artists.length > 0 && <span class="hm-srow-sub">{r.data.artists.join(', ')}</span>}
                </div>
              </a>
            ))}
          </div>

          <div class="hm-sound-col">
            <div class="hm-subhead"><span class="hm-subhead-t">The Stories</span><a class="hm-subhead-link" href="/thevicfix/">All {eps.length} episodes &rarr;</a></div>
            {latestEps.map((e) => (
              <a class="hm-srow" href={e.slug}>
                <div class="hm-srow-thumb">
                  {e.yt && <img src={`https://img.youtube.com/vi/${e.yt}/mqdefault.jpg`} alt={e.name} loading="lazy" width="116" height="65" />}
                  <span class="hm-srow-code">{epCode(e)}</span>
                </div>
                <div class="hm-srow-text">
                  <span class="hm-srow-type">{e.catLabel}</span>
                  <span class="hm-srow-title">{e.name}</span>
                  <span class="hm-srow-sub">{e.role}</span>
                </div>
              </a>
            ))}
            <p class="hm-sound-note">{upcomingEp ? `Next episode: ${upcomingEp.name}, premiering soon.` : 'New episodes every other Sunday.'}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8 · Enquiry -->
    <section id="enquire" class="hm-enquire">
      <div class="hm-inner">
        <div class="hm-head">
          <span class="hm-rule"></span>
          <span class="hm-eyebrow">Check your date</span>
          <h2 class="hm-h2">Let's talk about your night</h2>
        </div>
        <p class="hm-lead hm-enquire-lead">Tell VIC the date and the room. Every enquiry is read personally — no agency in between.</p>

        <div class="hm-enquire-grid">
          <div class="hm-enquire-left">
            <div class="hm-assur">
              <div class="hm-assur-cell"><span class="hm-assur-label">Response time</span><span class="hm-assur-val">Every enquiry answered within 24 hours.</span></div>
              <div class="hm-assur-cell"><span class="hm-assur-label">Coverage</span><span class="hm-assur-val">Based in Bangalore · available across India &amp; internationally.</span></div>
              <div class="hm-assur-cell"><span class="hm-assur-label">What you get</span><span class="hm-assur-val">VIC on the decks — not a sub-contracted stand-in.</span></div>
            </div>
            <a class="hm-wa" href="https://wa.me/919611711677" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              Message on WhatsApp
            </a>
            <div class="hm-direct">
              <a href="mailto:bookings@djvicofficial.com">bookings@djvicofficial.com</a>
              <a href="tel:+919611711677">+91 96117 11677</a>
            </div>
          </div>

          <div class="hm-enquire-right">
            <form id="hm-enquiry-form" class="hm-form" novalidate>
              <div class="hm-form-row">
                <div class="hm-field"><label for="eq-name">Your name <span class="hm-req">*</span></label><input type="text" id="eq-name" name="name" placeholder="Full name" required /></div>
                <div class="hm-field"><label for="eq-phone">Phone / WhatsApp <span class="hm-req">*</span></label><input type="tel" id="eq-phone" name="phone" placeholder="+91 98765 43210" required /></div>
              </div>
              <div class="hm-form-row">
                <div class="hm-field"><label for="eq-email">Email</label><input type="email" id="eq-email" name="email" placeholder="your@email.com" /></div>
                <div class="hm-field"><label for="eq-type">Event type <span class="hm-req">*</span></label>
                  <select id="eq-type" name="eventType" required>
                    <option value="" disabled selected>Select one</option>
                    {eventTypes.map(([v, l]) => <option value={v}>{l}</option>)}
                  </select>
                </div>
              </div>
              <div class="hm-form-row">
                <div class="hm-field"><label for="eq-date">Event date</label><input type="date" id="eq-date" name="date" /></div>
                <div class="hm-field"><label for="eq-venue">City or venue</label><input type="text" id="eq-venue" name="venue" placeholder="Bangalore, or the venue name" /></div>
              </div>
              <div class="hm-field"><label for="eq-details">Tell VIC about the night</label><textarea id="eq-details" name="details" rows="4" placeholder="Guest count, the vibe you're after, anything that matters."></textarea></div>
              <input type="text" name="_company" id="eq-hp" style="display:none" tabindex="-1" autocomplete="off" />
              <button type="submit" id="eq-submit" class="hm-btn hm-btn--gold hm-form-submit">Send enquiry &rarr;</button>
              <p class="hm-form-msg" id="eq-msg" hidden></p>
              <p class="hm-form-fine">Prefer to browse first? See <a href="/weddings/">weddings</a>, <a href="/corporate/">corporate</a> or the <a href="/photos/">gallery</a>.</p>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <WeekendPopup events={weekend} />
</Layout>

<script>
  // Smooth-scroll any in-page #enquire link.
  document.querySelectorAll('a[href="#enquire"]').forEach((a) => {
    a.addEventListener('click', (e) => { e.preventDefault(); document.getElementById('enquire')?.scrollIntoView({ behavior: 'smooth' }); });
  });

  // Enquiry form → submit_booking RPC (same path /book/ uses), + ntfy ping to VIC.
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const NTFY = 'djvic-bookings-7k9f3hQ2pX8mN5vR';
  const form = document.getElementById('hm-enquiry-form');
  const msg = document.getElementById('hm-enquiry-form') && document.getElementById('eq-msg');

  // Prefill event type from ?type=
  try {
    const t = new URLSearchParams(location.search).get('type');
    const sel = document.getElementById('eq-type');
    if (t && sel && [...sel.options].some((o) => o.value === t)) sel.value = t;
  } catch (e) {}

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (id) => (document.getElementById(id)?.value || '').trim();
      if (document.getElementById('eq-hp')?.value) { show('Thanks — enquiry received.', true); return; } // honeypot
      const name = val('eq-name'), phone = val('eq-phone'), type = val('eq-type');
      if (!name || !phone || !type) { show('Add your name, number and event type.', false); return; }
      const btn = document.getElementById('eq-submit');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      const email = val('eq-email'), date = val('eq-date'), venue = val('eq-venue'), details = val('eq-details');
      const message = [details, email ? `Email: ${email}` : '', 'Source: Homepage enquiry'].filter(Boolean).join('\n');
      try {
        const r = await fetch(`${SB_URL}/rest/v1/rpc/submit_booking`, {
          method: 'POST',
          headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_name: name, p_contact: phone, p_event_type: type, p_event_date: date || null, p_venue: venue || null, p_city: venue || null, p_budget: null, p_message: message }),
        });
        if (!r.ok) throw new Error(await r.text());
        try { navigator.sendBeacon(`https://ntfy.sh/${NTFY}?title=${encodeURIComponent('🎧 Homepage enquiry — ' + name)}&priority=4&tags=tada`, new Blob([`${name} · ${type}${date ? ' · ' + date : ''}${venue ? ' · ' + venue : ''}\n${phone}`], { type: 'text/plain' })); } catch (e) {}
        if (typeof window.trackLead === 'function') window.trackLead(type);
        form.reset();
        show("Enquiry sent. VIC will get back to you within 24 hours — check WhatsApp.", true);
      } catch (err) {
        show("Couldn't send just now — please message on WhatsApp and I'll sort it out.", false);
        if (btn) { btn.disabled = false; btn.textContent = 'Send enquiry →'; }
      }
    });
  }
  function show(text, ok) {
    const m = document.getElementById('eq-msg');
    if (!m) return;
    m.textContent = text; m.hidden = false;
    m.className = 'hm-form-msg ' + (ok ? 'ok' : 'err');
  }
</script>

